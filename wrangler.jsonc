{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "deftday-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  // Static site served from Workers Assets. Attaching the custom domain
  // through the Workers API also creates the DNS record, which the Pages
  // custom-domain flow does not — that is why the site lives here.
  //
  // run_worker_first lets src/worker.ts see every request so it can redirect
  // www to the apex; the zone token cannot write redirect rules.
  // The studio error log (log.deftday.com) — errors only, no IPs.
  "d1_databases": [
    {
      "binding": "ERRORS_DB",
      "database_name": "deftday-errors",
      "database_id": "1996ef1f-5b47-4edc-bf74-1c34914e123b"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },

  /* munchview.app/watch is a Next.js app in its own Worker (munchview repo,
     web/app). It is bound here rather than given a route of its own: this
     Worker already owns the hostname, and one public entry point is one set
     of headers, one place redirects are decided, and one thing to reason
     about. The hop is internal — no second TLS handshake, no extra latency. */
  "services": [{ "binding": "WEB", "service": "munchview-web" }]
}