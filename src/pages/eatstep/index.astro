---
import Base from '../../layouts/Base.astro';
import SiteChrome from '../../components/SiteChrome.astro';
import Footer from '../../components/Footer.astro';

/* Kept honest on purpose: the platform is in development. The APKs are real,
   installable builds served from the same objects the download pages use —
   the day it reaches a store, the badge and this line change together. */
const status = 'In development — Android APKs you can install today';
const updated = 'August 8, 2026';

/* Real captures from the release builds (customer 1.50.1, partner 1.7.7,
   courier 1.8.5), taken on August 8, 2026 — whole screens, nothing staged.
   The film is one continuous recording of the customer app: open, browse,
   and the Trainer tab holding the day's real numbers. */
const updatedShots = 'August 8, 2026';

/* The three things worth knowing before any feature. The first one is the
   whole product in one line: it comes from the real analysis in the film. */
const proof = [
  { n: '380 kcal', label: 'becomes a 9,500-step goal — every meal converts to movement' },
  { n: '3', label: 'apps on one platform: customer, kitchen, courier' },
  { n: '0', label: 'ads, trackers or analytics in any of them' },
];

const downloads = [
  {
    name: 'EatStep',
    who: 'for eating well and walking it off',
    href: 'https://apk.deftday.com/eatstep',
  },
  {
    name: 'EatStep Partner',
    who: 'for the kitchen taking orders',
    href: 'https://apk.deftday.com/eatstep-partner',
  },
  {
    name: 'EatStep Courier',
    who: 'for delivering on foot, by bike or motor',
    href: 'https://apk.deftday.com/eatstep-courier',
  },
];
---

<Base
  title="EatStep — order healthy, then walk it off"
  description="EatStep is a healthy-food delivery platform where every meal converts to steps. Order from nutrition-first kitchens, point the camera at any plate for an AI estimate, and close the calories as a step goal. Three Android apps, in development."
>
  <SiteChrome />
  <div class="sky" aria-hidden="true">
    <span class="s1"></span><span class="s2"></span><span class="s3"></span>
  </div>
  <div class="progress" aria-hidden="true"></div>

  <main id="main" class="es">
    <!-- Hero: the promise on one side; on the other, a film of the app
         keeping it — browse, and the Trainer tab holding today's balance. -->
    <section class="hero-2" aria-labelledby="top">
      <div class="hero-copy">
        <span class="eyebrow">EatStep · Android · three apps</span>
        <h1 id="top">Order the meal.<br /><span class="serif">Then walk it off.</span></h1>
        <p class="lede">
          Food delivery keeps score in one direction: what came in. EatStep
          keeps the other half too. Every dish carries its calories and macros
          up front, and after you eat, the app turns the meal into a step goal
          your phone's own step counter can close — for bonus points, not
          guilt.
        </p>
        <p class="status"><span class="badge testing">{status}</span></p>
        <p class="hero-links">
          <a class="cta" href="https://apk.deftday.com/eatstep">Get the customer app</a>
          <a class="cta ghost" href="#trainer">See the AI trainer</a>
        </p>
      </div>

      <div class="hero-phone">
        <div class="phone shot">
          <video
            class="screen-img"
            src="/eatstep/demo.mp4"
            poster="/eatstep/shots/demo-poster.webp"
            width="648"
            height="1440"
            autoplay
            muted
            loop
            playsinline
            aria-label="A thirty-second screen recording of the EatStep customer app: the home screen with healthy venues, a vegan kitchen's menu, and the Trainer tab showing 380 calories taken in and a one-day streak."
          ></video>
        </div>
        <p class="cap">A real recording — browsing, and the day's balance on the Trainer tab.</p>
      </div>
    </section>

    <ul class="proof" aria-label="What EatStep is">
      {proof.map((p) => (
        <li><b>{p.n}</b><span>{p.label}</span></li>
      ))}
    </ul>

    <section class="feature" aria-labelledby="order">
      <div class="feature-text">
        <span class="kicker">The marketplace half</span>
        <h2 id="order">Menus that state their numbers</h2>
        <p>
          Every venue on EatStep is a healthy-food kitchen, and every dish
          shows its calories and protein right on the card — before you order,
          not on a label you never see. Diet tags like vegan and gluten-free
          are the venue's own promise, shown up front.
        </p>
        <ol class="steps">
          <li><b>Browse.</b> Restaurants, market and stores in one place.</li>
          <li><b>Check the numbers.</b> 380 kcal · 26 g protein, on the card.</li>
          <li><b>Order.</b> Delivery, pickup with a code, or the kitchen's own fleet.</li>
        </ol>
      </div>
      <div class="shot-wrap">
        <div class="phone shot">
          <img
            class="screen-img"
            src="/eatstep/shots/venue.webp"
            alt="A vegan kitchen's page in the EatStep customer app: cover photo, 4.9 rating, delivery time, vegan and gluten-free tags, and a salad listed with 380 calories and 26 grams of protein."
            width="648"
            height="1440"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="cap">Calories and protein on the menu card, where the decision happens.</p>
      </div>
    </section>

    <section class="feature reverse" aria-labelledby="trainer">
      <div class="feature-text">
        <span class="kicker">The trainer half</span>
        <h2 id="trainer">Point the camera at any plate</h2>
        <p>
          Meals you did not order still count. The built-in trainer looks at a
          photo, names what it sees, and estimates calories and macros — as a
          range, because that is what a photo can honestly give. A slider and
          portion presets let you correct it in one gesture; verified dishes
          use curated reference values instead of a guess.
        </p>
        <p>
          Under every estimate sits the same conversion: what this plate means
          in steps and walking time. The one in the picture is
          380&nbsp;kcal&nbsp;≈&nbsp;9,500 steps&nbsp;≈&nbsp;1&nbsp;h&nbsp;35&nbsp;min.
        </p>
      </div>
      <div class="shot-wrap">
        <div class="phone shot">
          <img
            class="screen-img"
            src="/eatstep/shots/analysis.webp"
            alt="An analysis result in the EatStep app: avocado recognized with high confidence, an estimate of 380 calories with a 285 to 475 range, reference-value badge, macros, portion presets, and a total line converting the meal to 9,500 steps or about an hour and a half of walking."
            width="648"
            height="1440"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="cap">A real analysis — ranged estimate, portion control, and the step conversion.</p>
      </div>
    </section>

    <section class="feature" aria-labelledby="debt">
      <div class="feature-text">
        <span class="kicker">The part that closes the loop</span>
        <h2 id="debt">Every meal can become a walk</h2>
        <p>
          Save a meal and EatStep offers a balance goal: melt this plate with
          steps inside 24 hours. Your phone's step counter does the measuring —
          connect Health Connect once and the app reads steps only, nothing
          else. Close the goal in its window and you earn bonus EatStep points
          on top of the points every order already gives.
        </p>
        <ul class="points">
          <li>
            <b>Honest units.</b> Goals are set in steps and minutes, computed
            from your own weight — not a generic burn chart.
          </li>
          <li>
            <b>A window, not a debt spiral.</b> 24 hours, then it expires
            quietly. No streak shaming, no red numbers.
          </li>
          <li>
            <b>Points you can spend.</b> Bonuses land in the same balance you
            pay with at checkout.
          </li>
        </ul>
      </div>
      <div class="shot-wrap">
        <div class="phone shot">
          <img
            class="screen-img"
            src="/eatstep/shots/goal.webp"
            alt="The sheet after saving a meal: 'Meal saved', 380 calories added to today's intake, an offer to melt it with roughly 9,500 steps in 24 hours for bonus EatStep points, and buttons to open the balance goal or just save."
            width="648"
            height="1440"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="cap">Saved — and offered as a 9,500-step goal with a bonus at the end.</p>
      </div>
    </section>

    <!-- The three-app row: the platform in one picture. -->
    <figure class="trio-band" aria-labelledby="trio-label">
      <div class="trio">
        <div class="trio-item">
          <div class="phone shot">
            <img
              class="screen-img"
              src="/eatstep/shots/trainer.webp"
              alt="The customer app's Trainer tab: today's balance ring with 380 calories in, the analyze button with two of three daily analyses left, and a history holding today's meal."
              width="648"
              height="1440"
              loading="lazy"
              decoding="async"
            />
          </div>
          <p class="trio-cap"><b>EatStep</b><span>eat, analyze, walk</span></p>
        </div>
        <div class="trio-item">
          <div class="phone shot">
            <img
              class="screen-img"
              src="/eatstep/shots/partner-menu.webp"
              alt="The partner app's menu screen: a bowl listed at 520 calories and 189.90 lira, live on sale with a toggle, and an add-product button."
              width="648"
              height="1440"
              loading="lazy"
              decoding="async"
            />
          </div>
          <p class="trio-cap"><b>Partner</b><span>orders and a nutrition-first menu</span></p>
        </div>
        <div class="trio-item">
          <div class="phone shot">
            <img
              class="screen-img"
              src="/eatstep/shots/courier-home.webp"
              alt="The courier app's home screen: an offline toggle, today's delivery earnings and Step Points, a reliability score of 100, and a documents-in-review banner."
              width="648"
              height="1440"
              loading="lazy"
              decoding="async"
            />
          </div>
          <p class="trio-cap"><b>Courier</b><span>deliver on foot or by pedal</span></p>
        </div>
      </div>
      <figcaption id="trio-label">
        One platform, three apps — the same design system and the same step
        economy on every side of an order.
      </figcaption>
    </figure>

    <section class="feature reverse" aria-labelledby="partner">
      <div class="feature-text">
        <span class="kicker">For the kitchen</span>
        <h2 id="partner">A menu editor that speaks nutrition</h2>
        <p>
          The partner app onboards a kitchen in minutes: name the business,
          add dishes with photos, price small, regular and large portions
          separately, and — because this is EatStep — give every dish its
          calories, protein, carbs and fat in the same form. Incoming orders
          land on a live board; a switch takes a dish off sale without
          deleting it.
        </p>
        <p>
          Kitchens with their own couriers keep them: fleet orders stay
          exclusive to the restaurant's riders, and the platform never
          delivers with a fleet of its own.
        </p>
      </div>
      <div class="shot-wrap">
        <div class="phone shot">
          <img
            class="screen-img"
            src="/eatstep/shots/partner-nutrition.webp"
            alt="The partner app's add-product form: per-portion prices for small, medium and large, and nutrition fields for calories, protein, carbs and fat filled in with 520, 42, 45 and 14."
            width="648"
            height="1440"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="cap">Portion pricing and nutrition, in the same add-dish form.</p>
      </div>
    </section>

    <section class="feature" aria-labelledby="courier">
      <div class="feature-text">
        <span class="kicker">For the courier</span>
        <h2 id="courier">Deliveries that earn Step Points</h2>
        <p>
          EatStep couriers choose how they move. Walking and cycling need no
          paperwork and earn Step Points on top of delivery pay — the same
          currency customers earn by closing meal goals. Motor and car
          couriers upload documents once and are reviewed before their first
          job.
        </p>
        <p>
          A reliability score starts at 100 and stays visible on the home
          screen: finish reservations on time and it stays high; the score —
          not an opaque algorithm — is what gates the higher-value orders.
        </p>
      </div>
      <div class="shot-wrap">
        <div class="phone shot">
          <img
            class="screen-img"
            src="/eatstep/shots/courier-onboarding.webp"
            alt="The courier app's onboarding: a profile photo, a name, and vehicle types where walking and bicycle are selected — both marked as earning Step Points — while motorcycle and car require document approval."
            width="648"
            height="1440"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="cap">Walk or pedal from day one — motor vehicles go through document review.</p>
      </div>
    </section>

    <section class="feature reverse" aria-labelledby="privacy-row">
      <div class="feature-text">
        <span class="kicker">Asked first, in plain words</span>
        <h2 id="privacy-row">Your plate is personal data</h2>
        <p>
          Meal photos are health-adjacent data, so the app treats them that
          way: before the first analysis it asks for explicit consent in plain
          Turkish, and the decision is stored on the device. Photos are
          processed transiently for the analysis and are not kept on the
          server; location and EXIF metadata are stripped before a photo
          leaves the phone.
        </p>
        <p>
          Consent is revocable from the same screen it was given on. Guest
          meal logs never leave the device at all — they migrate to an account
          only when you sign in and only after the server confirms each one.
        </p>
      </div>
      <div class="shot-wrap">
        <div class="phone shot">
          <img
            class="screen-img"
            src="/eatstep/shots/consent.webp"
            alt="EatStep's photo-analysis consent sheet, in Turkish: photos are processed only for coaching, never for ads and never shared; processed transiently and not stored on the server; location and EXIF stripped on the device; consent revocable any time. Accept and not-now buttons below."
            width="648"
            height="1440"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="cap">The consent sheet, before the first photo — revocable from the same place.</p>
      </div>
    </section>

    <div class="prose">
      <section class="block" aria-labelledby="why">
        <h2 id="why">Why a delivery app counts steps</h2>
        <p>
          Every food app makes eating easier. None of them owns what happens
          after — that is a different app, a different account, a different
          habit. EatStep's bet is that the two halves belong in one loop:
          the order already knows its calories, the phone already counts your
          steps, and a platform that sees both can turn dinner into tomorrow
          morning's walk without a spreadsheet in between.
        </p>
      </section>

      <section class="block" aria-labelledby="privacy">
        <h2 id="privacy">No ads, no tracking, no dark patterns</h2>
        <p>
          None of the three apps carries ads, analytics or trackers. The
          platform necessarily handles accounts, addresses and orders — that
          data does its job and nothing else. Step data is read for one
          purpose, meal goals, and photo analysis runs under explicit,
          revocable consent.
        </p>
        <p>
          <a href="/privacy">The studio privacy policy<span aria-hidden="true"> →</span></a>
        </p>
      </section>
    </div>

    <section class="closer" aria-labelledby="get">
      <h2 id="get">Try all three today</h2>
      <p>
        EatStep is in active development and not in the stores yet. The
        Android builds below are the real, current apps — the same ones the
        screenshots on this page were taken from — installable directly.
      </p>
      <div class="dl-row">
        {downloads.map((d) => (
          <a class="dl-card" href={d.href}>
            <b>{d.name}</b>
            <span>{d.who}</span>
            <em>Download APK<i aria-hidden="true"> →</i></em>
          </a>
        ))}
      </div>
      <p class="fine">
        Android 8.0 or newer. Your phone will ask you to allow installs from
        the browser — that is normal for apps outside a store.
      </p>
    </section>

    <p class="updated">Last updated: {updated} · Screens and film captured {updatedShots}</p>
  </main>

  <Footer />
</Base>

<style>
  /* Same page grammar as the Munchview page: prose gets a readable measure,
     picture rows use the width. */
  .es {
    max-width: 1180px;
    margin: 0 auto;
    padding: 150px var(--gutter) 40px;
    overflow-x: clip;
  }
  .prose {
    max-width: none;
  }
  .es section {
    padding: 0;
  }

  /* ---------- hero ---------- */
  .hero-2 {
    display: grid;
    gap: 44px;
    align-items: center;
  }
  .hero-2 h1 {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    margin-bottom: 26px;
  }
  .lede {
    color: var(--muted);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    text-wrap: pretty;
    max-width: 56ch;
  }
  .status {
    margin-top: 24px;
  }
  .hero-links {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 0 22px;
    border-radius: 100px;
    background: var(--grad);
    color: #1a0f08;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid transparent;
  }
  .cta.ghost {
    background: none;
    color: var(--ink);
    border-color: var(--line);
  }
  .cta:hover {
    filter: brightness(1.08);
  }
  .cta.ghost:hover {
    border-color: var(--sun-text);
    filter: none;
  }
  .hero-phone {
    justify-self: center;
    width: min(250px, 66vw);
    position: relative;
  }
  .hero-phone::before {
    content: '';
    position: absolute;
    inset: -14% -30%;
    background: radial-gradient(closest-side, rgba(0, 200, 150, 0.22), transparent);
    filter: blur(6px);
    z-index: -1;
  }
  .hero-phone video {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero-phone .cap {
    margin-top: 14px;
  }

  @media (min-width: 900px) {
    .hero-2 {
      grid-template-columns: 1fr minmax(0, 280px);
      gap: 70px;
    }
  }

  /* ---------- the proof strip ---------- */
  .proof {
    list-style: none;
    margin: 46px 0 0;
    padding: 24px 0;
    display: grid;
    gap: 22px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .proof li {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .proof b {
    font-family: var(--font-d);
    font-size: 1.9rem;
    line-height: 1;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    white-space: nowrap;
  }
  .proof span {
    color: var(--muted);
    font-size: 0.92rem;
    text-wrap: pretty;
  }
  @media (min-width: 720px) {
    .proof {
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 30px;
    }
  }

  /* ---------- feature rows ---------- */
  .feature {
    display: grid;
    gap: 34px;
    align-items: center;
    margin-top: 80px;
  }
  .kicker {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sun-text);
    margin-bottom: 12px;
  }
  .feature h2 {
    font-size: clamp(1.5rem, 3.2vw, 2.3rem);
    margin-bottom: 18px;
    text-wrap: balance;
  }
  .feature p {
    color: var(--muted);
    text-wrap: pretty;
    margin-bottom: 14px;
    max-width: 54ch;
  }
  .feature .shot-wrap {
    justify-self: center;
    width: min(232px, 62vw);
    position: relative;
  }
  .feature .shot-wrap::before {
    content: '';
    position: absolute;
    inset: -10% -26%;
    background: radial-gradient(closest-side, rgba(0, 200, 150, 0.14), transparent);
    z-index: -1;
  }
  .cap {
    margin-top: 16px;
    color: var(--muted);
    font-size: 0.84rem;
    text-align: center;
    text-wrap: pretty;
  }

  .steps,
  .points {
    color: var(--muted);
    display: grid;
    gap: 12px;
    margin: 20px 0 0;
    padding-left: 1.1rem;
    max-width: 54ch;
  }
  .steps {
    margin-bottom: 14px;
  }
  .steps b,
  .points b {
    color: var(--ink);
  }
  .points {
    list-style: none;
    padding-left: 0;
  }
  .points li {
    padding-left: 1.1rem;
    position: relative;
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--grad);
  }

  @media (min-width: 900px) {
    .feature {
      grid-template-columns: 1fr minmax(0, 260px);
      gap: 72px;
      margin-top: 104px;
    }
    .feature.reverse {
      grid-template-columns: minmax(0, 260px) 1fr;
    }
    .feature.reverse .feature-text {
      order: 2;
    }
    .feature.reverse .shot-wrap {
      order: 1;
    }
  }

  /* ---------- the three-app band ---------- */
  /* This platform's one picture that needs no caption logic: the same design
     system on all three sides of an order. Three real phones, side by side. */
  .trio-band {
    margin: 104px 0 0;
    text-align: center;
  }
  .trio {
    display: grid;
    gap: 34px;
    justify-items: center;
    grid-template-columns: 1fr;
  }
  .trio-item {
    width: min(210px, 58vw);
  }
  .trio-cap {
    margin-top: 14px;
    display: grid;
    gap: 2px;
  }
  .trio-cap b {
    font-family: var(--font-d);
    font-size: 1.02rem;
  }
  .trio-cap span {
    color: var(--muted);
    font-size: 0.82rem;
  }
  .trio-band figcaption {
    margin: 26px auto 0;
    max-width: 54ch;
    color: var(--muted);
    font-size: 0.9rem;
    text-wrap: pretty;
  }
  @media (min-width: 760px) {
    .trio {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: end;
    }
    /* The customer phone leads by a shoulder — it is the app the other two
       exist for. */
    .trio-item:first-child {
      width: min(232px, 26vw);
    }
  }

  /* ---------- text blocks ---------- */
  .block {
    margin-top: 64px;
    padding-top: 34px;
    border-top: 1px solid var(--line);
  }
  .block h2 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin-bottom: 18px;
  }
  .block p {
    color: var(--muted);
    text-wrap: pretty;
    margin-bottom: 14px;
    max-width: 72ch;
  }

  /* ---------- closing card ---------- */
  .es section.closer {
    margin-top: 72px;
    padding: clamp(28px, 5vw, 52px);
    border-radius: 26px;
    border: 1px solid var(--line);
    background: linear-gradient(150deg, var(--panel-2), var(--panel));
    text-align: center;
  }
  .closer h2 {
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    margin-bottom: 18px;
  }
  .closer p {
    color: var(--muted);
    text-wrap: pretty;
    margin-inline: auto;
    max-width: 56ch;
  }
  .dl-row {
    margin-top: 30px;
    display: grid;
    gap: 14px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) {
    .dl-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .dl-card {
    display: grid;
    gap: 6px;
    justify-items: center;
    padding: 22px 18px;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: rgba(243, 239, 231, 0.02);
    text-decoration: none;
    transition: border-color 0.25s, transform 0.25s;
  }
  .dl-card:hover {
    border-color: var(--sun-text);
    transform: translateY(-2px);
  }
  .dl-card b {
    font-family: var(--font-d);
    font-size: 1.05rem;
    color: var(--ink);
  }
  .dl-card span {
    color: var(--muted);
    font-size: 0.84rem;
    text-wrap: pretty;
  }
  .dl-card em {
    margin-top: 8px;
    font-style: normal;
    font-weight: 700;
    font-size: 0.9rem;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .closer .fine {
    margin-top: 18px;
    font-size: 0.85rem;
  }

  .updated {
    margin-top: 40px;
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* The film is the one thing on the page that moves; under reduced motion it
     must not. The poster stays, which is the same first frame. */
  @media (prefers-reduced-motion: reduce) {
    .hero-phone video {
      display: none;
    }
    .hero-phone .phone::after {
      content: '';
      display: block;
      width: 100%;
      aspect-ratio: 648 / 1440;
      background: url('/eatstep/shots/demo-poster.webp') center / cover no-repeat;
      border-radius: inherit;
    }
  }
</style>

<script>
  // Reduced motion: never autoplay the film. The CSS hides it; this also
  // stops the download and the playback for browsers that got that far.
  const video = document.querySelector<HTMLVideoElement>('.hero-phone video');
  if (video && matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.removeAttribute('autoplay');
    video.pause();
  }
</script>
