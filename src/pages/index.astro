---
import Base from '../layouts/Base.astro';
import DesktopHero from '../components/DesktopHero.astro';
import Manifesto from '../components/Manifesto.astro';
import AppsGrid from '../components/AppsGrid.astro';
import Lab from '../components/Lab.astro';
import Craft from '../components/Craft.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="DeftDay Studio — Independent App & Game Studio for iOS & Android"
  description="DeftDay builds apps, games and everyday utilities for iOS, Android and the web — home of EatStep, Munchview, Pickorn and SkyBattleSea. Small independent studio, everything crafted in-house."
>
  <DesktopHero />
  <main>
    <Manifesto />
    <AppsGrid />
    <Lab />
    <Craft />
    <Contact />
  </main>
  <Footer />
</Base>
