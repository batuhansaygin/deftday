---
import Base from '../layouts/Base.astro';
import SiteChrome from '../components/SiteChrome.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import AppsGrid from '../components/AppsGrid.astro';
import Lab from '../components/Lab.astro';
import Craft from '../components/Craft.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="DeftDay Studio — Indie Apps & Games for iOS, Android & Web"
  description="DeftDay is an independent studio crafting apps, games and utilities for iOS, Android and the web — home of EatStep, Munchview, Pickorn and SkyBattleSea."
>
  {/* Ambient sky: static gradient layers the scroll timeline raises and fades in. */}
  <div class="sky" aria-hidden="true">
    <span class="s1"></span>
    <span class="s2"></span>
    <span class="s3"></span>
  </div>
  <div class="progress" aria-hidden="true"></div>
  <SiteChrome />
  <main id="main">
    <Hero />
    <Manifesto />
    <AppsGrid />
    <Lab />
    <Craft />
    <Contact />
  </main>
  <Footer />
</Base>
