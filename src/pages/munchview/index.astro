---
import Base from '../../layouts/Base.astro';
import SiteChrome from '../../components/SiteChrome.astro';
import Footer from '../../components/Footer.astro';

/* Kept honest on purpose: the app is on a closed test track, not in the store.
   The day it is public, the badge and this line change together. */
const status = 'In closed testing on Google Play';
const updated = 'July 28, 2026';

/* Real captures from the release build, not mockups — same files that go to
   the Play listing, so the two can never drift apart. */
const shots = [
  {
    src: '/munchview/shots/01-categories.webp',
    alt: 'Munchview asking what you like to watch, with categories such as Documentary bites, Nature and travel and Cosmos selected.',
    caption: 'Pick a few things you like. Once.',
  },
  {
    src: '/munchview/shots/02-home.webp',
    alt: 'The Munchview home screen: the question “How long have you got?”, three length presets, and a large Press to watch button.',
    caption: 'One question. One button.',
  },
  {
    src: '/munchview/shots/03-player.webp',
    alt: 'A video playing full screen in Munchview, with the controls floating over the picture.',
    caption: 'Controls float over the picture, then get out of the way.',
  },
  {
    src: '/munchview/shots/04-corner.webp',
    alt: 'A video continuing to play in a small movable window in the corner while the home screen is visible behind it.',
    caption: 'Drag it down and it keeps playing in the corner.',
  },
  {
    src: '/munchview/shots/05-picks.webp',
    alt: 'The Picked for you row on the Munchview home screen, showing video thumbnails chosen from what you have watched.',
    caption: 'Picked from what you liked — worked out on the phone.',
  },
  {
    src: '/munchview/shots/06-you.webp',
    alt: 'The You screen in Munchview, showing Munchview Pro, an optional Continue with Google button, and the profile switcher.',
    caption: 'Signing in is optional, and it only carries your taste across.',
  },
  {
    src: '/munchview/shots/07-liked.webp',
    alt: 'The lower half of the You screen: an autoplay switch, a list of liked videos, a Not for you list, and Clear watch history.',
    caption: 'Everything it knows about you, in one place you can empty.',
  },
];
---

<Base
  title="Munchview — say how long you have, and watch"
  description="Munchview starts a good YouTube video that fits the time you have — a lunch break, a study session, something on in the workshop, winding down. No feed, no browsing. Android, in closed testing."
>
  <SiteChrome />
  <div class="sky" aria-hidden="true">
    <span class="s1"></span><span class="s2"></span><span class="s3"></span>
  </div>
  <div class="progress" aria-hidden="true"></div>

  <main id="main" class="product">
    <span class="eyebrow">Munchview</span>
    <h1>Say how long you have.<br /><span class="serif">Then just watch.</span></h1>
    <p class="lede">
      Every app in this category opens by asking what you are in the mood for.
      Munchview is built on the belief that the asking is the problem. Tell it
      how long you have got — ten minutes, forty, whatever you set — and
      something worth watching is already playing.
    </p>
    <p class="status"><span class="badge testing">{status}</span></p>

    <section class="shots" aria-labelledby="shots-h">
      <h2 id="shots-h" class="sr-only">What Munchview looks like</h2>
      <ul class="strip">
        {
          shots.map((shot) => (
            <li class="shot">
              <img src={shot.src} alt={shot.alt} width="540" height="1200" loading="lazy" decoding="async" />
              <p>{shot.caption}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block" aria-labelledby="how">
      <h2 id="how">Three seconds, start to watching</h2>
      <p>
        The whole app was built against a stopwatch. Open it, press one button,
        and a video is running. There is no feed to fall into, no autoplay
        rabbit hole, and nothing to scroll before you have chosen anything.
      </p>
      <ol class="steps">
        <li><b>Open it.</b> One question, one button.</li>
        <li><b>Say how long.</b> A preset, or any length you like.</li>
        <li><b>Watch.</b> It is already playing.</li>
      </ol>
    </section>

    <section class="block" aria-labelledby="whenever">
      <h2 id="whenever">Not only at mealtimes</h2>
      <p>
        It started as something to watch while you eat, and it outgrew that. A
        study break, something on in the workshop while your hands are busy, a
        match in the background, winding down before sleep — the question is
        always the same one, and so is the answer.
      </p>
    </section>

    <section class="block" aria-labelledby="picks">
      <h2 id="picks">It learns, without watching you</h2>
      <p>
        What it plays is ranked from what you have told it: the categories you
        chose, the length you asked for, the channels you liked, the ones you
        turned down, and what you have already been shown so the same few
        videos do not come round again. All of that is worked out on the phone.
      </p>
      <ul class="points">
        <li>
          <b>Your country's categories.</b> The list comes from YouTube for
          wherever you are, so it offers what people there actually watch.
        </li>
        <li>
          <b>Type a show, keep it as a tag.</b> Write the name of something you
          like and it joins the mix, matched to the length you asked for.
        </li>
        <li>
          <b>A seat each.</b> Separate profiles keep separate tastes — two free,
          ten with Pro.
        </li>
        <li>
          <b>Keeps playing in the corner.</b> Drag the video down and it carries
          on in a window you can move and resize while you look for the next one.
        </li>
      </ul>
    </section>

    <section class="block" aria-labelledby="privacy">
      <h2 id="privacy">No ads, no tracking, no feed</h2>
      <p>
        Munchview is not funded by advertising, so it is not built to watch you.
        As a guest it collects nothing at all: what you like, skip and save
        stays on the phone. Signing in with Google is optional and does exactly
        one thing — carries that to a second phone. It asks Google only who you
        are, never for access to your YouTube account.
      </p>
      <p>
        <a href="/munchview/privacy">Read the full privacy policy<span aria-hidden="true"> →</span></a>
        &nbsp;·&nbsp;
        <a href="/munchview/delete-account">Delete your account<span aria-hidden="true"> →</span></a>
      </p>
    </section>

    <section class="block" aria-labelledby="status">
      <h2 id="status">Where it is right now</h2>
      <p>
        Munchview is on a closed test track on Google Play. It is a finished,
        installable app — the test track exists so it is used on real phones by
        real people before it goes public, which is also what Google asks of a
        new developer account.
      </p>
      <p>
        Want to be one of the testers? Write to
        <a href="mailto:hello@deftday.com?subject=Munchview%20tester">hello@deftday.com</a>
        with the Google account you use on your Android phone, and we will add
        you to the track.
      </p>
      <p class="updated">Last updated: {updated}</p>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .product {
    max-width: 78ch;
    margin: 0 auto;
    padding: 160px var(--gutter) 40px;
  }
  .product h1 {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    margin-bottom: 28px;
  }
  .lede {
    color: var(--muted);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    text-wrap: pretty;
    max-width: 62ch;
  }
  .status {
    margin-top: 26px;
  }
  .block {
    margin-top: 56px;
    padding-top: 34px;
    border-top: 1px solid var(--line);
  }
  .block h2 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin-bottom: 18px;
  }
  .block p {
    color: var(--muted);
    text-wrap: pretty;
    margin-bottom: 14px;
  }
  .steps,
  .points {
    color: var(--muted);
    display: grid;
    gap: 12px;
    margin: 18px 0 0;
    padding-left: 1.1rem;
  }
  .steps b,
  .points b {
    color: var(--fg);
  }
  .points {
    list-style: none;
    padding-left: 0;
  }
  .points li {
    padding-left: 1.1rem;
    position: relative;
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--grad);
  }
  .updated {
    margin-top: 22px;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Screens. A scrolling strip on a phone, a wrapping row on a desktop —
     the images are tall, so a plain grid would leave a page of whitespace. */
  .shots {
    margin-top: 48px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .strip {
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 4px 0 18px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }
  .shot {
    flex: 0 0 auto;
    width: min(232px, 62vw);
    scroll-snap-align: center;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: #12100e;
  }
  .shot p {
    margin: 12px 2px 0;
    color: var(--muted);
    font-size: 0.86rem;
    text-wrap: pretty;
  }
  @media (prefers-reduced-motion: reduce) {
    .strip {
      scroll-behavior: auto;
    }
  }
</style>
