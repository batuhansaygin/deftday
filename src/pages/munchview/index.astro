---
import Base from '../../layouts/Base.astro';
import SiteChrome from '../../components/SiteChrome.astro';
import Footer from '../../components/Footer.astro';
import { SITE_URL, STATUS_LINE, STATUS_CLAUSE } from '../../config/munchview';

/* Kept honest on purpose: the app is on a closed test track, not in the store.
   The day it is public, the badge and this line change together. */
const status = STATUS_LINE;
const updated = 'August 7, 2026';

/* Real captures from the release build of 1.2.18, whole screens rather than
   crops. The film in the hero is one continuous screen recording of the same
   build — open, tap, watching — cut with title cards and nothing staged. */
const updatedShots = 'August 7, 2026';

/* The three things worth knowing before any feature. Kept as data so the strip
   cannot drift out of step with itself. */
const proof = [
  { n: '3s', label: 'from opening it to watching' },
  { n: '6', label: 'platforms, one calm player' },
  /* "in the app" is load-bearing: this page itself is measured, cookielessly,
     and the studio privacy page says so. */
  { n: '0', label: 'ads, trackers or analytics in the app' },
];
---

<Base
  title="Munchview — say how long you have, and watch"
  description={`Munchview starts a good video that fits the time you have — a lunch break, a study session, something on in the workshop, winding down. Six platforms, one player, no feed. Android, ${STATUS_CLAUSE}.`}
>
  <SiteChrome />
  <div class="sky" aria-hidden="true">
    <span class="s1"></span><span class="s2"></span><span class="s3"></span>
  </div>
  <div class="progress" aria-hidden="true"></div>

  <main id="main" class="mv">
    <!-- Hero: the promise on one side; on the other, a film of the app
         keeping it. Muted, looping, twelve seconds, captions burned in — it
         works exactly like the demo clip Play will get. -->
    <section class="hero-2" aria-labelledby="top">
      <div class="hero-copy">
        <span class="eyebrow">Munchview · Android</span>
        <h1 id="top">Say how long you have.<br /><span class="serif">Then just watch.</span></h1>
        <p class="lede">
          Every app in this category opens by asking what you are in the mood
          for. Munchview is built on the belief that the asking is the problem.
          Tell it how long you have got — ten minutes, forty, whatever you set —
          and something worth watching is already playing.
        </p>
        <p class="status"><span class="badge testing">{status}</span></p>
        <p class="hero-links">
          <a class="cta" href={SITE_URL}>Visit munchview.app</a>
          <a class="cta ghost" href="mailto:hello@deftday.com?subject=Munchview%20tester">Ask to be a tester</a>
          <a class="cta ghost" href="#how">See how it works</a>
        </p>
        <!-- The app has its own home now. This page stays as the studio's
             account of it — who made it and why — and sends the reader there
             for the product itself. Two properties that link to each other
             read as related rather than as a site and a stranger. -->
      </div>

      <div class="hero-phone">
        <div class="phone shot">
          <video
            class="screen-img"
            src="/munchview/demo.mp4"
            poster="/munchview/shots/demo-poster.webp"
            width="648"
            height="1440"
            autoplay
            muted
            loop
            playsinline
            aria-label="A seventeen-second screen recording: the Munchview home screen asks how long you have, a length is chosen, the watch button is pressed, and a video is playing moments later."
          ></video>
        </div>
        <p class="cap">A real recording of the app — open, one press, watching.</p>
        <p class="cap">
          <a href="#film">Watch the full ninety seconds &rarr;</a>
        </p>
      </div>
    </section>

    <ul class="proof" aria-label="What Munchview is">
      {proof.map((p) => (
        <li><b>{p.n}</b><span>{p.label}</span></li>
      ))}
    </ul>

    <section class="feature" aria-labelledby="how">
      <div class="feature-text">
        <span class="kicker">The whole idea</span>
        <h2 id="how">Three seconds, start to watching</h2>
        <p>
          The app was built against a stopwatch. Open it, press one button, and
          a video is running. There is no feed to fall into, no autoplay rabbit
          hole, and nothing to scroll before you have chosen anything.
        </p>
        <ol class="steps">
          <li><b>Open it.</b> One question, one button.</li>
          <li><b>Say how long.</b> A preset, or any length you like.</li>
          <li><b>Watch.</b> It is already playing.</li>
        </ol>
        <p>
          Under the player, "related to this" really means it — more of the
          programme you are watching, and the same subject from the other
          platforms, never six thumbnails from one channel.
        </p>
      </div>
      <div class="shot-wrap">
        <div class="phone shot">
          <img
            class="screen-img"
            src="/munchview/shots/player-feed.webp"
            alt="A TED talk about artificial intelligence playing at the top of the Munchview player, paused at 23 seconds of 16:25. The Related to this list underneath mixes TED videos with one carrying a Vimeo mark and one from Bright Side."
            width="648"
            height="1440"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="cap">Playing immediately — and what to watch next, from more than one place.</p>
      </div>
    </section>

    <section class="feature reverse" aria-labelledby="platforms">
      <div class="feature-text">
        <span class="kicker">Six platforms, one player</span>
        <h2 id="platforms">The whole open web of video</h2>
        <p>
          YouTube, Vimeo, Dailymotion, Twitch, PeerTube and the Internet
          Archive — one warm, calm player for all of them. Every video plays
          inside the app, and every card is marked with its platform's logo, so
          you know where a thing lives before you tap it.
        </p>
        <p>
          Pick the platforms you want in Settings, or let them all in. Paste
          any video link and it opens in the best player for it — nothing is
          handed off to a browser.
        </p>
      </div>
      <div class="shot-wrap">
        <div class="phone shot">
          <img
            class="screen-img"
            src="/munchview/shots/anyplayer.webp"
            alt="A riddles video inside Munchview’s own player, with the app’s amber controls over it: skip five seconds either way, thumbs down and thumbs up, previous and next, and share and settings down the right edge."
            width="648"
            height="1440"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="cap">A Dailymotion video, in Munchview's own player. Same controls everywhere.</p>
      </div>
    </section>

    <figure class="band">
      <div class="phone shot land">
        <img
          class="screen-img"
          src="/munchview/shots/fullscreen.webp"
          alt="A Vimeo basketball documentary filling an Android phone held sideways, edge to edge, with no controls or chrome over the picture at all."
          width="1440"
          height="648"
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption>
        Turn the phone and the app gets out of the way. A few seconds later the
        controls fade — even the progress line — and only the video is left.
      </figcaption>
    </figure>

    <section class="feature" aria-labelledby="picks">
      <div class="feature-text">
        <span class="kicker">Taste, worked out on the phone</span>
        <h2 id="picks">It learns, without watching you</h2>
        <p>
          What it plays is ranked from what you have told it: the categories you
          chose, the length you asked for, the channels you liked, the ones you
          turned down, and what you have already seen — so the same few videos
          do not come round again, and what you have already watched goes to
          the back of every row. All of it is worked out on the phone.
        </p>
        <ul class="points">
          <li>
            <b>Your country's categories.</b> The list comes from YouTube for
            wherever you are, so it offers what people there actually watch.
          </li>
          <li>
            <b>Type a show, keep it as a tag.</b> Write the name of something
            you like and it joins the mix — found on every platform that has
            it, matched to the length you asked for.
          </li>
          <li>
            <b>Short breaks too.</b> A Shorts row for the ninety-second pauses,
            picked by the same taste as everything else. Autoplay is a switch,
            not a decision made for you.
          </li>
          <li>
            <b>Pick up where you stopped.</b> Everything you started keeps its
            place, with an amber line on the picture showing how far you got.
          </li>
        </ul>
      </div>
      <div class="shot-wrap">
        <div class="phone shot">
          <img
            class="screen-img"
            src="/munchview/shots/discover.webp"
            alt="The Munchview home screen scrolled down: a Just slide row of vertical short clips, and under it You might also like, built from what the phone has been watching."
            width="648"
            height="1440"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="cap">Continue watching, and a Discover list built from what you finish.</p>
      </div>
    </section>

    <section class="feature reverse" aria-labelledby="connections">
      <div class="feature-text">
        <span class="kicker">Optional, and read-only</span>
        <h2 id="connections">Connections, told straight</h2>
        <p>
          Bring what you already like on a platform into your picks. YouTube,
          Twitch, Vimeo and Dailymotion all connect — one button each, in the
          platform's own colour, wearing the platform's own icon. Every
          connection is read-only, and what comes in stays <em>its own
          list</em>, never mixed into Munchview's, because you should always
          be able to tell which app thought what.
        </p>
        <p>
          What comes in is honest per platform: your likes from Vimeo and
          Dailymotion, and the latest recordings of channels you follow on
          Twitch, which has no likes to read. Munchview never likes,
          subscribes, comments or changes anything on your account, and
          disconnecting removes the imported list from the phone.
        </p>
      </div>
      <div class="shot-wrap">
        <div class="phone shot">
          <img
            class="screen-img"
            src="/munchview/shots/connections-4.webp"
            alt="Munchview’s Connections screen: Twitch, Vimeo and Dailymotion rows, each with its real app icon and a Connect button in its own colour, and a Connect YouTube button below them."
            width="648"
            height="1440"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="cap">Four platforms, four real buttons — each import stays its own list.</p>
      </div>
    </section>

    <div class="prose">
      <section class="block" aria-labelledby="whenever">
        <h2 id="whenever">Not only at mealtimes</h2>
        <p>
          It started as something to watch while you eat, and it outgrew that. A
          study break, something on in the workshop while your hands are busy, a
          match in the background, winding down before sleep — the question is
          always the same one, and so is the answer.
        </p>
      </section>

      <section class="block" aria-labelledby="privacy">
        <h2 id="privacy">No ads, no tracking, no feed</h2>
        <p>
          Munchview is not funded by advertising, so it is not built to watch
          you. As a guest it collects nothing at all: what you like, skip and
          save stays on the phone. Signing in with Google is optional and does
          exactly one thing — carries that to a second phone, and one tap wipes
          what it stored. It asks Google only who you are; connecting YouTube
          is a separate choice you make yourself, and it only ever reads.
        </p>
        <p>
          <a href="/munchview/privacy">Read the full privacy policy<span aria-hidden="true"> →</span></a>
          &nbsp;·&nbsp;
          <a href="/munchview/terms">Terms<span aria-hidden="true"> →</span></a>
          &nbsp;·&nbsp;
          <a href="/munchview/delete-account">Delete your account<span aria-hidden="true"> →</span></a>
        </p>
      </section>
    </div>

    <section class="closer" aria-labelledby="status">
      <h2 id="status">Where it is right now</h2>
      <p>
        Munchview is on a closed test track on Google Play. It is a finished,
        installable app — the track exists so it is used on real phones by real
        people before it goes public, which is also what Google asks of a new
        developer account.
      </p>
      <p class="closer-cta">
        <a class="cta" href="mailto:hello@deftday.com?subject=Munchview%20tester">Ask to be a tester</a>
      </p>
      <p class="fine">
        Write from the Google account you use on your Android phone and we will
        add you to the track.
      </p>
    </section>


    <!-- The whole thing, once, for anyone who wants more than the loop.
         Not autoplayed and not preloaded: a ninety-second file has no business
         downloading itself for a reader who never scrolls this far. `controls`
         because this one is watched deliberately rather than glanced at. -->
    <section id="film" class="wrap film" aria-labelledby="film-h">
      <h2 id="film-h">The whole thing, unedited</h2>
      <p class="film-lede">
        Ninety seconds of the release build, in one take: opening it, choosing a
        length, a video playing in YouTube's own player, the rails it builds
        from what you watch, and the settings underneath. Nothing staged, no
        cuts.
      </p>
      <div class="film-frame">
        <video
          src="/munchview/film.mp4"
          poster="/munchview/shots/demo-poster.webp"
          width="648"
          height="1440"
          controls
          playsinline
          preload="none"
          aria-label="A ninety-second screen recording of Munchview: the home screen, choosing a length, pressing watch, a video playing in the official YouTube player, the recommendation rails, and the settings screens."
        ></video>
      </div>
    </section>

    <p class="updated">Last updated: {updated} · Screens and film captured {updatedShots}</p>
  </main>

  <Footer />
</Base>

<style>
  /* The page is wider than a document because half of it is pictures. Prose
     still gets a readable measure; only the picture rows use the full width. */
  .mv {
    max-width: 1180px;
    margin: 0 auto;
    padding: 150px var(--gutter) 40px;
    /* The glows behind the phones are absolutely positioned and reach past
       their wrapper, which on a narrow screen widens the scrollable area and
       drags every line of text off the right edge. They are decoration, so they
       are the thing that gets cut. */
    overflow-x: clip;
  }
  .prose {
    max-width: none;
  }
  /* The site-wide `section` rule pads every section by up to 160px top and
     bottom and a whole page gutter either side. That is right for the
     homepage's full-bleed bands; here it wrapped each row in 320px of dead
     space and pushed the text past the right edge on a phone. These rows set
     their own rhythm. */
  .mv section {
    padding: 0;
  }

  /* ---------- hero ---------- */
  .hero-2 {
    display: grid;
    gap: 44px;
    align-items: center;
  }
  .hero-2 h1 {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    margin-bottom: 26px;
  }
  .lede {
    color: var(--muted);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    text-wrap: pretty;
    max-width: 56ch;
  }
  .status {
    margin-top: 24px;
  }
  .hero-links {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 0 22px;
    border-radius: 100px;
    background: var(--grad);
    color: #1a0f08;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid transparent;
  }
  .cta.ghost {
    background: none;
    color: var(--ink);
    border-color: var(--line);
  }
  .cta:hover {
    filter: brightness(1.08);
  }
  .cta.ghost:hover {
    border-color: var(--sun-text);
    filter: none;
  }
  .hero-phone {
    justify-self: center;
    width: min(250px, 66vw);
    position: relative;
  }
  /* Light behind the phone, so it sits in the page instead of on top of it. */
  .hero-phone::before {
    content: '';
    position: absolute;
    inset: -14% -30%;
    background: radial-gradient(closest-side, rgba(255, 92, 56, 0.24), transparent);
    filter: blur(6px);
    z-index: -1;
  }
  /* The film sits in the same frame the stills use; the element differs, the
     look must not. */
  .hero-phone video {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero-phone .cap {
    margin-top: 14px;
  }

  @media (min-width: 900px) {
    .hero-2 {
      grid-template-columns: 1fr minmax(0, 280px);
      gap: 70px;
    }
  }

  /* ---------- the proof strip ---------- */
  .proof {
    list-style: none;
    margin: 46px 0 0;
    padding: 24px 0;
    display: grid;
    gap: 22px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .proof li {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .proof b {
    font-family: var(--font-d);
    font-size: 1.9rem;
    line-height: 1;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .proof span {
    color: var(--muted);
    font-size: 0.92rem;
    text-wrap: pretty;
  }
  @media (min-width: 720px) {
    .proof {
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
    }
  }

  /* ---------- feature rows ---------- */
  .feature {
    display: grid;
    gap: 34px;
    align-items: center;
    margin-top: 80px;
  }
  .kicker {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sun-text);
    margin-bottom: 12px;
  }
  .feature h2 {
    font-size: clamp(1.5rem, 3.2vw, 2.3rem);
    margin-bottom: 18px;
    text-wrap: balance;
  }
  .feature p {
    color: var(--muted);
    text-wrap: pretty;
    margin-bottom: 14px;
    max-width: 54ch;
  }
  .feature .shot-wrap {
    justify-self: center;
    width: min(232px, 62vw);
    position: relative;
  }
  .feature .shot-wrap::before {
    content: '';
    position: absolute;
    inset: -10% -26%;
    background: radial-gradient(closest-side, rgba(255, 176, 58, 0.16), transparent);
    z-index: -1;
  }
  .cap {
    margin-top: 16px;
    color: var(--muted);
    font-size: 0.84rem;
    text-align: center;
    text-wrap: pretty;
  }

  .steps,
  .points {
    color: var(--muted);
    display: grid;
    gap: 12px;
    margin: 20px 0 0;
    padding-left: 1.1rem;
    max-width: 54ch;
  }
  .steps {
    margin-bottom: 14px;
  }
  .steps b,
  .points b {
    color: var(--ink);
  }
  .points {
    list-style: none;
    padding-left: 0;
  }
  .points li {
    padding-left: 1.1rem;
    position: relative;
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--grad);
  }

  @media (min-width: 900px) {
    .feature {
      grid-template-columns: 1fr minmax(0, 260px);
      gap: 72px;
      margin-top: 104px;
    }
    /* Alternate the side the phone lands on, so the eye is not dragged down
       one rail for the length of the page. */
    .feature.reverse {
      grid-template-columns: minmax(0, 260px) 1fr;
    }
    .feature.reverse .feature-text {
      order: 2;
    }
    .feature.reverse .shot-wrap {
      order: 1;
    }
  }

  /* ---------- the landscape band ---------- */
  /* The one screen whose whole point is that nothing else is on it, so it gets
     the width to say so. */
  .band {
    margin: 104px 0 0;
    text-align: center;
  }
  .band .phone {
    margin-inline: auto;
    width: min(880px, 100%);
  }
  .band figcaption {
    margin: 20px auto 0;
    max-width: 54ch;
    color: var(--muted);
    font-size: 0.9rem;
    text-wrap: pretty;
  }

  /* ---------- text blocks ---------- */
  .block {
    margin-top: 64px;
    padding-top: 34px;
    border-top: 1px solid var(--line);
  }
  .block h2 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin-bottom: 18px;
  }
  .block p {
    color: var(--muted);
    text-wrap: pretty;
    margin-bottom: 14px;
    max-width: 72ch;
  }

  /* ---------- closing card ---------- */
  .mv section.closer {
    margin-top: 72px;
    padding: clamp(28px, 5vw, 52px);
    border-radius: 26px;
    border: 1px solid var(--line);
    background: linear-gradient(150deg, var(--panel-2), var(--panel));
    text-align: center;
  }
  .closer h2 {
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    margin-bottom: 18px;
  }
  .closer p {
    color: var(--muted);
    text-wrap: pretty;
    margin-inline: auto;
    max-width: 56ch;
  }
  .closer-cta {
    margin-top: 28px;
  }
  .fine {
    margin-top: 16px;
    font-size: 0.85rem;
  }

  .updated {
    margin-top: 40px;
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* The film is the one thing on the page that moves; under reduced motion it
     must not. The poster stays, which is the same first frame. */
  @media (prefers-reduced-motion: reduce) {
    .hero-phone video {
      display: none;
    }
    .hero-phone .phone::after {
      content: '';
      display: block;
      width: 100%;
      aspect-ratio: 648 / 1440;
      background: url('/munchview/shots/demo-poster.webp') center / cover no-repeat;
      border-radius: inherit;
    }
  }

  /* The full film. Narrow, because it is a phone recording and stretching it
     across a desk-width column would say the opposite of what the app is. */
  .film { padding-top: 8px; }
  .film-lede { color: var(--muted); max-width: 56ch; text-wrap: pretty; }
  .film-frame {
    margin-top: 28px;
    width: min(324px, 72vw);
    border-radius: 28px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #000;
  }
  .film-frame video { display: block; width: 100%; height: auto; }
</style>

<script>
  // Reduced motion: never autoplay the film. The CSS hides it; this also
  // stops the download and the playback for browsers that got that far.
  const video = document.querySelector<HTMLVideoElement>('.hero-phone video');
  if (video && matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.removeAttribute('autoplay');
    video.pause();
  }
</script>
