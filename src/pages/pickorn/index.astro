---
import Base from '../../layouts/Base.astro';
import SiteChrome from '../../components/SiteChrome.astro';
import Footer from '../../components/Footer.astro';

/* Kept honest on purpose: the app is headed for a closed test track, not in
   the store. The day it is public, the badge and this line change together. */
const status = 'In closed testing on Android';
const updated = 'August 24, 2026';

/* Real captures from the release build of 3.3, whole screens rather than
   crops — the same screens the Play listing uses, without the caption bands. */
const updatedShots = 'August 24, 2026';

/* The three things worth knowing before any feature. Kept as data so the strip
   cannot drift out of step with itself. The film count is the dataset's own
   number, not a rounding. */
const proof = [
  { n: '33,319', label: 'IMDb-rated films, already on the phone' },
  { n: '11', label: 'languages, from Turkish to Traditional Chinese' },
  { n: '0', label: 'ads, trackers or accounts — in the app or planned' },
];
---

<Base
  title="Pickorn — one tap, one film"
  description="Pickorn asks how you feel tonight and hands you exactly one film — not a grid, not a queue. 33,319 IMDb-rated films ship inside the app, so choosing works offline. Android, in closed testing."
>
  <SiteChrome />

  <main id="main" class="pk">
    <!-- Hero: the promise on one side, the shipped home screen keeping it on
         the other. The screen is a capture of the release build, so the page
         can never promise a UI the app does not have. -->
    <section class="hero-2" aria-labelledby="top">
      <div class="hero-copy">
        <span class="eyebrow">Pickorn · Android</span>
        <h1 id="top">One tap.<br /><span class="serif">One film.</span></h1>
        <p class="lede">
          Twenty minutes choosing a film is twenty minutes not watching one.
          Every streaming surface answers "what should we watch?" with a
          thousand thumbnails. Pickorn is built on the belief that the
          scrolling is the problem: say how you feel tonight — or say nothing
          at all — and it hands you exactly one film. Don't like it? Roll
          again.
        </p>
        <p class="status"><span class="badge testing">{status}</span></p>
        <p class="hero-links">
          <a class="cta" href="mailto:hello@deftday.com?subject=Pickorn%20tester"
            >Ask to be a tester</a
          >
          <a class="cta ghost" href="#how">See how it works</a>
        </p>
      </div>

      <div class="hero-phone">
        <div class="phone shot">
          <img
            class="screen-img"
            src="/pickorn/shots/home.jpg"
            alt="The Pickorn home screen: 'What are we watching tonight?' above a single deep-red PICK A MOVIE button, a note that 33,319 films are in tonight's pool, and two quiet rows for mood and fine-tune."
            width="648"
            height="1440"
          />
        </div>
        <p class="cap">The whole app is this decision. Everything else is optional.</p>
      </div>
    </section>

    <ul class="proof" aria-label="What Pickorn is">
      {
        proof.map((p) => (
          <li>
            <b>{p.n}</b>
            <span>{p.label}</span>
          </li>
        ))
      }
    </ul>

    <section class="feature" aria-labelledby="how">
      <div class="feature-text">
        <span class="kicker">The whole idea</span>
        <h2 id="how">A decision, not a feed</h2>
        <p>
          There is no browsing surface to fall into. The home screen asks one
          question and offers one button; pressing it weighs the pool — your
          mood, your filters, what you have already seen — and deals a single
          film with its IMDb rating, plot, cast and a straight road to its
          IMDb page.
        </p>
        <ol class="steps">
          <li><b>Open it.</b> One question, one button.</li>
          <li><b>Tap.</b> One film, chosen for tonight.</li>
          <li><b>Roll again</b> if it isn't the one. That is the escape hatch.</li>
        </ol>
        <p>
          Films you have watched never come back around, and anything worth
          keeping goes to a watchlist — both live only on the phone.
        </p>
      </div>
      <div class="shot-wrap">
        <div class="phone shot">
          <img
            class="screen-img"
            src="/pickorn/shots/result.jpg"
            alt="A result card: Toy Story 3 with its IMDb rating, year and runtime, genre line, plot, director and cast, above Pick another, watchlist and IMDb buttons."
            width="648"
            height="1440"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="cap">Tonight's film — rating, story, cast, and a roll-again button.</p>
      </div>
    </section>

    <section class="feature reverse" aria-labelledby="moods">
      <div class="feature-text">
        <span class="kicker">Start from a feeling</span>
        <h2 id="moods">Twelve moods, set like a menu</h2>
        <p>
          Make me laugh. Scare me. Something emotional. Blow my mind. The mood
          list reads like a cinema programme rather than a genre dropdown —
          pick a line and the pool re-weighs itself around it. Skip it
          entirely and the whole catalogue is in play.
        </p>
        <p>
          For the evenings that need precision there is a fine-tune sheet:
          era back to the classics, a minimum rating of 6, 7 or 8, a runtime
          cap for school nights, and country of origin from 150 countries.
        </p>
      </div>
      <div class="shot-wrap">
        <div class="phone shot">
          <img
            class="screen-img"
            src="/pickorn/shots/moods.jpg"
            alt="The mood menu under 'How do you feel tonight?' — twelve serif lines including Make me laugh, Scare me, Feeling romantic, Blow my mind and Surprise me."
            width="648"
            height="1440"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="cap">The mood menu — editorial lines, not genre chips.</p>
      </div>
    </section>

    <section class="feature" aria-labelledby="offline">
      <div class="feature-text">
        <span class="kicker">No connection required</span>
        <h2 id="offline">The catalogue lives on the phone</h2>
        <p>
          All 33,319 films — titles, years, ratings, plots, casts, countries —
          ship inside the app. Picking a film makes no network request, so it
          works on a plane, on the underground, or with the data saver on.
          Exactly two things ever leave the device: poster images load from
          IMDb's image CDN, and the IMDb page opens when you tap through.
        </p>
        <ul class="points">
          <li><b>No account.</b> Nothing to sign up for, nothing to reset.</li>
          <li><b>No ads, no analytics, no tracking.</b> Not a data business.</li>
          <li>
            <b>Everything local.</b> Watchlist, watched films and filters stay
            in the phone's own storage — <a href="/privacy#pickorn">the privacy page</a>
            says exactly what leaves it.
          </li>
        </ul>
      </div>
      <div class="shot-wrap">
        <div class="phone shot">
          <img
            class="screen-img"
            src="/pickorn/shots/filters.jpg"
            alt="The fine-tune sheet: genre chips, era row with 2010s selected in gold, minimum rating with 8+ selected, runtime buckets and a country picker."
            width="648"
            height="1440"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="cap">Fine-tune when you want to — era, rating, runtime, country.</p>
      </div>
    </section>

    <section class="closer" aria-labelledby="closing">
      <h2 id="closing">Built by DeftDay</h2>
      <p>
        Pickorn is made by <a href="/">DeftDay</a>, an independent studio, and
        speaks eleven languages: English, Turkish, French, German, Italian,
        Russian, Arabic, Spanish, Japanese and both Simplified and Traditional
        Chinese. It is on a closed Android test track on its way to Google
        Play — if you would like to run it early,
        <a href="mailto:hello@deftday.com?subject=Pickorn%20tester">write to the studio</a>.
      </p>
    </section>

    <p class="updated">Last updated: {updated} · Screens captured {updatedShots}</p>
  </main>

  <Footer />
</Base>

<style>
  /* Pickorn's own room: the site's structure, the app's palette. The page
     ground shifts toward the app's night navy, and the accents are its
     champagne gold and the velvet of its one button — so the page reads as
     the product's, not as a re-skinned Munchview. */
  .pk {
    max-width: 1180px;
    margin: 0 auto;
    padding: 150px var(--gutter) 40px;
    overflow-x: clip;
    --pk-gold: #e6c87a;
    --pk-gold-dim: rgba(230, 200, 122, 0.32);
    --pk-velvet: #a53a50;
    --pk-velvet-deep: #5e1d2c;
  }
  .pk section {
    padding: 0;
  }
  .pk .serif {
    background: linear-gradient(120deg, #f4dc9c, #e6c87a 55%, #c2a054);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pk-gold);
    margin-bottom: 18px;
  }
  .kicker {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pk-gold);
    margin-bottom: 12px;
  }

  /* ---------- hero ---------- */
  .hero-2 {
    display: grid;
    gap: 44px;
    align-items: center;
  }
  .hero-2 h1 {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    margin-bottom: 26px;
  }
  .lede {
    color: var(--muted);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    text-wrap: pretty;
    max-width: 56ch;
  }
  .status {
    margin-top: 24px;
  }
  .hero-links {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  /* The one filled button on the page is the app's one filled button:
     velvet, with ivory text — the same 7:1 pairing the CTA ships with. */
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 0 22px;
    border-radius: 100px;
    background: linear-gradient(160deg, var(--pk-velvet), var(--pk-velvet-deep));
    color: #f6e9dc;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid transparent;
  }
  .cta.ghost {
    background: none;
    color: var(--ink);
    border-color: var(--line);
  }
  .cta:hover {
    filter: brightness(1.12);
  }
  .cta.ghost:hover {
    border-color: var(--pk-gold-dim);
    filter: none;
  }
  .hero-phone {
    justify-self: center;
    width: min(250px, 66vw);
    position: relative;
  }
  /* Champagne light behind the phone — a near-black screen on a dark page
     needs something to sit in front of. */
  .hero-phone::before {
    content: '';
    position: absolute;
    inset: -14% -30%;
    background: radial-gradient(closest-side, rgba(230, 200, 122, 0.2), transparent);
    filter: blur(6px);
    z-index: -1;
  }
  .hero-phone .cap {
    margin-top: 14px;
  }

  @media (min-width: 900px) {
    .hero-2 {
      grid-template-columns: 1fr minmax(0, 280px);
      gap: 70px;
    }
  }

  /* ---------- the proof strip ---------- */
  .proof {
    list-style: none;
    margin: 46px 0 0;
    padding: 24px 0;
    display: grid;
    gap: 22px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .proof li {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .proof b {
    font-family: var(--font-d);
    font-size: 1.9rem;
    line-height: 1;
    background: linear-gradient(120deg, #f4dc9c, #c2a054);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .proof span {
    color: var(--muted);
    font-size: 0.92rem;
    text-wrap: pretty;
  }
  @media (min-width: 720px) {
    .proof {
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
    }
  }

  /* ---------- feature rows ---------- */
  .feature {
    display: grid;
    gap: 34px;
    align-items: center;
    margin-top: 80px;
  }
  .feature h2 {
    font-size: clamp(1.5rem, 3.2vw, 2.3rem);
    margin-bottom: 18px;
    text-wrap: balance;
  }
  .feature p {
    color: var(--muted);
    text-wrap: pretty;
    margin-bottom: 14px;
    max-width: 54ch;
  }
  .feature .shot-wrap {
    justify-self: center;
    width: min(232px, 62vw);
    position: relative;
  }
  .feature .shot-wrap::before {
    content: '';
    position: absolute;
    inset: -10% -26%;
    background: radial-gradient(closest-side, rgba(230, 200, 122, 0.14), transparent);
    z-index: -1;
  }
  .cap {
    margin-top: 16px;
    color: var(--muted);
    font-size: 0.84rem;
    text-align: center;
    text-wrap: pretty;
  }

  .steps,
  .points {
    color: var(--muted);
    display: grid;
    gap: 12px;
    margin: 20px 0 0;
    padding-left: 1.1rem;
    max-width: 54ch;
  }
  .steps {
    margin-bottom: 14px;
  }
  .steps b,
  .points b {
    color: var(--ink);
  }
  .points {
    list-style: none;
    padding-left: 0;
  }
  .points li {
    padding-left: 1.1rem;
    position: relative;
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--pk-gold);
  }
  .points a,
  .closer a {
    color: var(--ink);
  }

  @media (min-width: 860px) {
    .feature {
      grid-template-columns: 1fr minmax(0, 260px);
      gap: 70px;
    }
    .feature.reverse {
      grid-template-columns: minmax(0, 260px) 1fr;
    }
    .feature.reverse .feature-text {
      order: 2;
    }
  }

  /* ---------- closing ---------- */
  .closer {
    margin-top: 90px;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }
  .closer h2 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin-bottom: 18px;
  }
  .closer p {
    color: var(--muted);
    text-wrap: pretty;
    max-width: 72ch;
  }

  .updated {
    margin-top: 70px;
    color: var(--muted);
    font-size: 0.8rem;
  }
</style>
