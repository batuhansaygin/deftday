---
/**
 * munchview.app — the app's own front door.
 *
 * The owner bought the domain on 2026-08-15 and asked for the look of
 * JustWatch: night navy, gold, a cinematic top. The LOOK is what is borrowed.
 * The layout is not, and deliberately: JustWatch is a catalogue that tells you
 * where a film streams and hands you to Netflix. Munchview starts something
 * now. Copying a catalogue's shape — search bar, provider grid, rows of
 * posters — would sell a product this is not, and `store/ASO.md` in the app
 * repo says in as many words that competing as a finder is a fight we lose.
 *
 * Everything on this page is the app's own: the colours are the tokens from
 * src/theme/tokens.ts, the mark is the icon's own foreground layer, and the
 * screenshots are whole screens from the release build — no mockups, no
 * device frames drawn round a render.
 *
 * Status text comes from ../../config/munchview so this page cannot outlive
 * the closed test the way five other surfaces once nearly did.
 */
import { LIVE, PLAY_URL, SIGN_IN_READY, STATUS_BADGE, STATUS_CLAUSE } from '../../config/munchview';
/* The pairing flow itself lives on /signin, not here. It is several steps with
   a code and a countdown — one decision per screen, the same law the app is
   built on — and inlining a component that carries its own script in two
   places on one page would run that script twice. */

const site = 'https://munchview.app';

const lengths = [
  { n: '10', unit: 'min', what: 'a coffee, a queue, a bus stop' },
  { n: '20', unit: 'min', what: 'lunch at your desk' },
  { n: '30+', unit: 'min', what: 'the sofa, properly' },
];

const platforms = ['YouTube', 'Vimeo', 'Dailymotion', 'Twitch', 'PeerTube', 'Internet Archive'];

/* Real captures from 1.3.41, the build published the same day. Whole screens,
   at the size the pages already expect. */
const shots = {
  home: '/munchview/shots/new-home.webp',
  player: '/munchview/shots/new-player.webp',
  discover: '/munchview/shots/new-discover.webp',
  preferences: '/munchview/shots/new-preferences.webp',
};

const features = [
  {
    title: 'No feed to fall into',
    body:
      'There is no infinite scroll and no autoplay tunnel. A handful of picks, a list built from what you actually finish, and every one of them ends on purpose.',
  },
  {
    title: 'Cut to the time you have',
    body:
      'Say ten minutes and you get something that fits in ten. Not a ninety-minute episode with a progress bar you will abandon at the door.',
  },
  {
    title: 'It learns on your phone',
    body:
      'Like a video to see more of it; say “not for me” and that channel stays away. The learning lives on the device. No account is needed to use any of it.',
  },
  {
    title: 'Your country, your language',
    body:
      'Pick a country and the whole feed follows it — the search goes out in that country’s language, not in English with a flag on it.',
  },
  {
    title: 'One player for six platforms',
    body:
      'Everything plays inside the app, in each platform’s own official embedded player. One set of controls to learn, one place to be.',
  },
  {
    title: 'Nothing watching you',
    body:
      'No analytics, no trackers, no advertising of ours — in either tier. The platforms run their own ads inside their players; those are theirs, and we say so rather than pretending otherwise.',
  },
];

/* Structured data. Google reads this to build the app result; every field is
   true of the listing it describes, which is the same rule the store copy is
   held to. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: 'Munchview',
  operatingSystem: 'Android',
  applicationCategory: 'EntertainmentApplication',
  url: site,
  installUrl: PLAY_URL,
  image: `${site}/munchview/brand/icon-512.png`,
  description:
    'Say how long you have and a good video starts playing. Six platforms, one player, no feed.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'DeftDay Studio', url: 'https://deftday.com' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Munchview — say how long you have, and watch</title>
    <meta
      name="description"
      content={`Munchview starts a good video that fits the time you have — ten minutes, twenty, thirty and up. Six platforms, one player, no feed. Android, ${STATUS_CLAUSE}.`}
    />
    <meta name="theme-color" content="#0E101A" />
    <link rel="canonical" href={`${site}/`} />

    <link rel="icon" href="/munchview/brand/icon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/munchview/brand/icon-180.png" />

    <meta property="og:site_name" content="Munchview" />
    <meta property="og:title" content="Munchview — say how long you have, and watch" />
    <meta
      property="og:description"
      content="A good video that fits the time you have. Six platforms, one player, no feed."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:image" content={`${site}/munchview/brand/icon-512.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Munchview — say how long you have, and watch" />
    <meta
      name="twitter:description"
      content="A good video that fits the time you have. Six platforms, one player, no feed."
    />
    <meta name="twitter:image" content={`${site}/munchview/brand/icon-512.png`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <style>
      /* The app's tokens, verbatim. If these ever drift from
         munchview/src/theme/tokens.ts the site is lying about the product. */
      :root {
        --bg: #0e101a;
        --surface: #181b26;
        --surface-high: #222633;
        --line: #222633;
        --accent: #ffb300;
        --accent-pressed: #e09e00;
        --ink: #eef2f6;
        --muted: #8d949b;
        --radius: 14px;
        --page: 1120px;
      }

      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font: 16px/1.6 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; }
      img { max-width: 100%; height: auto; display: block; }
      .wrap { width: min(100% - 40px, var(--page)); margin-inline: auto; }

      .nav {
        position: sticky; top: 0; z-index: 20;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
      }
      .nav-in { display: flex; align-items: center; gap: 16px; height: 62px; }
      .brand { display: flex; align-items: center; gap: 10px; font-weight: 800; letter-spacing: .02em; text-decoration: none; }
      .brand img { width: 28px; height: 28px; }
      .nav .spacer { flex: 1; }
      .nav a.quiet { color: var(--muted); text-decoration: none; font-size: 14px; }
      .nav a.quiet:hover { color: var(--ink); }

      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        background: var(--accent); color: #1a1200; font-weight: 800;
        border: 0; border-radius: 100px; padding: 12px 22px;
        text-decoration: none; cursor: pointer; font-size: 15px; min-height: 44px;
      }
      .btn:hover { background: var(--accent-pressed); }
      .btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--line); }
      .btn.ghost:hover { border-color: var(--muted); background: var(--surface); }

      .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); }
      /* The cinema of the reference, built from gradients rather than a
         photograph: nothing here has to be licensed, and it stays sharp at
         every width. */
      .hero::before {
        content: ""; position: absolute; inset: -30% -10% auto -10%; height: 120%;
        background:
          radial-gradient(60% 55% at 78% 18%, rgba(255, 179, 0, .18), transparent 62%),
          radial-gradient(45% 45% at 12% 8%, rgba(90, 120, 255, .15), transparent 60%);
        filter: blur(6px); pointer-events: none;
      }
      .hero-in {
        position: relative; padding: 88px 0 76px;
        display: grid; grid-template-columns: 1.05fr .95fr; gap: 56px; align-items: center;
      }
      .eyebrow {
        display: inline-flex; align-items: center; gap: 9px;
        font-size: 12.5px; letter-spacing: .13em; text-transform: uppercase;
        color: var(--muted); margin: 0 0 20px;
      }
      .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
      h1 {
        margin: 0 0 20px; font-size: clamp(36px, 5.2vw, 60px); line-height: 1.05;
        letter-spacing: -.025em; font-weight: 800;
      }
      h1 em { font-style: normal; color: var(--accent); }
      .lede { margin: 0 0 30px; font-size: clamp(16.5px, 1.5vw, 19px); color: var(--muted); max-width: 52ch; }
      .cta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
      .cta small { color: var(--muted); font-size: 13.5px; }

      /* The phone: the screenshot IS the frame — a real capture, edge to edge,
         with a rounded clip and a soft lift under it. No drawn bezel. */
      .phone {
        justify-self: center; width: min(300px, 78vw);
        border-radius: 26px; overflow: hidden;
        border: 1px solid var(--line);
        box-shadow: 0 40px 90px rgba(0, 0, 0, .55), 0 0 0 1px rgba(255, 255, 255, .03);
      }

      .lengths { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin: 8px 0 0; }
      .len {
        background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
        padding: 20px 18px; transition: border-color .18s ease, transform .18s ease;
      }
      .len:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--line)); transform: translateY(-2px); }
      .len b { display: block; font-size: 30px; line-height: 1; letter-spacing: -.02em; }
      .len b span { font-size: 14px; color: var(--muted); font-weight: 700; margin-left: 4px; }
      .len p { margin: 9px 0 0; color: var(--muted); font-size: 14px; }

      section { padding: 76px 0; border-bottom: 1px solid var(--line); }
      h2 { margin: 0 0 10px; font-size: clamp(24px, 3.4vw, 34px); letter-spacing: -.02em; }
      .sub { margin: 0 0 34px; color: var(--muted); max-width: 62ch; }

      .shots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
      .shot { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
      .shot img { border-bottom: 1px solid var(--line); }
      .shot figcaption { padding: 16px 18px; color: var(--muted); font-size: 14.5px; }
      .shot figcaption b { color: var(--ink); display: block; margin-bottom: 4px; font-size: 15.5px; }

      .rail { display: flex; flex-wrap: wrap; gap: 10px; }
      .chip { border: 1px solid var(--line); background: var(--surface); border-radius: 100px; padding: 10px 18px; font-size: 14.5px; }

      .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
      .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px 22px; }
      .card h3 { margin: 0 0 9px; font-size: 17.5px; letter-spacing: -.01em; }
      .card p { margin: 0; color: var(--muted); font-size: 15px; }

      .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; counter-reset: s; }
      .step { position: relative; padding-left: 52px; }
      .step::before {
        counter-increment: s; content: counter(s);
        position: absolute; left: 0; top: -2px; width: 36px; height: 36px; border-radius: 50%;
        display: grid; place-items: center; background: var(--surface-high); color: var(--accent); font-weight: 800;
      }
      .step h3 { margin: 4px 0 6px; font-size: 17px; }
      .step p { margin: 0; color: var(--muted); font-size: 15px; }

      .close { text-align: center; padding: 84px 0; border-bottom: 0; }
      .close h2 { margin-bottom: 22px; }

      footer { padding: 40px 0 56px; color: var(--muted); font-size: 14px; }
      .foot-in { display: flex; flex-wrap: wrap; gap: 8px 22px; align-items: center; }
      footer a { color: var(--muted); text-decoration: none; }
      footer a:hover { color: var(--ink); text-decoration: underline; }
      footer .spacer { flex: 1; }

      @media (max-width: 980px) {
        .hero-in { grid-template-columns: 1fr; gap: 40px; padding: 64px 0 56px; }
        .shots, .grid, .steps { grid-template-columns: 1fr; }
        .phone { order: -1; }
      }
      @media (max-width: 620px) { .lengths { grid-template-columns: 1fr; } }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        * { transition: none !important; animation: none !important; }
      }
      :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 6px; }
      .skip { position: absolute; left: -9999px; }
      .skip:focus { left: 16px; top: 12px; z-index: 50; }
    
  /* The film. Kept to a phone's width — stretching a phone recording across a
     desk-width column would say the opposite of what this app is. */
  .film-frame {
    margin: 32px auto 0;
    width: min(324px, 74vw);
    border-radius: 28px;
    overflow: hidden;
    border: 1px solid var(--line, #222633);
    background: #000;
  }
  .film-frame video { display: block; width: 100%; height: auto; }
      /* ----------------------------------------------------- scroll story --
         The device is sticky and the screens cross-fade inside it, so the eye
         stays on one object while the argument moves. Only opacity and
         transform animate; nothing here forces a layout while scrolling. */
      .sr-only { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); }
      .story-grid { display:grid; grid-template-columns:1fr 1fr; gap:clamp(24px,5vw,72px); align-items:start; }
      .panel { min-height:74vh; display:flex; flex-direction:column; justify-content:center;
               opacity:.32; transition:opacity 420ms ease; }
      .panel.on { opacity:1; }
      .panel h3 { font-size:clamp(24px,3.4vw,40px); line-height:1.1; letter-spacing:-.02em; margin:0; }
      .panel p { color:var(--muted); font-size:clamp(15px,1.6vw,19px); line-height:1.5; margin:14px 0 0; max-width:34ch; }
      .panel-shot { display:none; margin:26px 0 0; }
      .story-stage { position:sticky; top:12vh; height:74vh; display:flex; align-items:center; justify-content:center; }
      .stage-glow { position:absolute; width:min(680px,80vw); aspect-ratio:1; border-radius:50%; pointer-events:none;
        background:radial-gradient(closest-side, rgba(255,179,0,.16) 0%, rgba(255,179,0,.05) 46%, rgba(255,179,0,0) 72%); filter:blur(8px); }
      .stage-phone { position:relative; width:min(320px,72vw); aspect-ratio:648/1440; padding:10px; border-radius:38px;
        background:linear-gradient(155deg,#3B4058 0%,#0A0C14 26%,#0A0C14 74%,#3B4058 100%);
        box-shadow:inset 0 3px 8px rgba(255,255,255,.18), 0 40px 80px rgba(0,0,0,.55), 0 12px 28px rgba(0,0,0,.45); }
      .stage-phone img { position:absolute; inset:10px; width:calc(100% - 20px); height:auto; border-radius:28px;
        opacity:0; transform:scale(1.012); transition:opacity 460ms ease, transform 460ms ease; }
      .stage-phone img.on { opacity:1; transform:none; }

      @media (max-width: 900px) {
        .story-grid { grid-template-columns:1fr; }
        .story-stage { display:none; }
        .panel { min-height:0; opacity:1; padding:clamp(36px,8vh,72px) 0; }
        .panel-shot { display:flex; justify-content:center; }
        .panel-shot img { width:min(300px,74vw); border-radius:26px; }
      }

      @media (prefers-reduced-motion: reduce) {
        .panel, .stage-phone img { transition:none; }
        .panel { opacity:1; }
      }

</style>
  </head>

  <body>
    <a class="btn ghost skip" href="#main">Skip to content</a>

    <nav class="nav">
      <div class="wrap nav-in">
        <a class="brand" href="/">
          <img src="/munchview/brand/mark-96.png" width="28" height="28" alt="" />
          Munchview
        </a>
        <span class="spacer"></span>
        <a class="quiet" href="#how">How it works</a>
        <a class="quiet" href="https://deftday.com/munchview/privacy">Privacy</a>
        {SIGN_IN_READY ? (
          <a class="btn" href="/signin" data-signed-in-swap>Sign in</a>
        ) : (
          <a class="btn" href={PLAY_URL}>{LIVE ? 'Get it on Play' : 'Join the test'}</a>
        )}
      </div>
    </nav>

    <header class="hero">
      <div class="wrap hero-in">
        <div>
          <p class="eyebrow"><span class="dot"></span> Android · {STATUS_BADGE}</p>
          <h1>Say how long you have. <em>Then just watch.</em></h1>
          <p class="lede">
            Every other app opens by asking what you are in the mood for. Munchview is built on
            the belief that the asking is the problem. Tell it how long you have got, and
            something worth watching is already playing.
          </p>
          <div class="cta">
            {SIGN_IN_READY ? (
              <>
                <a class="btn" href="/signin" data-signed-in-swap>Sign in</a>
                <a class="btn ghost" href={PLAY_URL}>Get the app</a>
                <small>Same account as your phone — your profiles, history and picks.</small>
              </>
            ) : (
              <>
                <a class="btn" href={PLAY_URL}>{LIVE ? 'Get it on Google Play' : 'Join the closed test'}</a>
                <a class="btn ghost" href="#how">See how it works</a>
                <small>Free. No account needed.</small>
              </>
            )}
          </div>
        </div>
        <img
          class="phone"
          src={shots.home}
          width="648"
          height="1440"
          alt="Munchview's home screen: the question “How long have you got?”, three length buttons with ~20 min chosen, and a large WATCH button."
          fetchpriority="high"
        />
      </div>
    </header>

    <main id="main">
      <section id="how" class="wrap">
        <h2>Three seconds, three taps, done</h2>
        <p class="sub">That is the whole product. Everything else exists to keep it true.</p>
        <div class="steps">
          <div class="step">
            <h3>Open it</h3>
            <p>No sign-up, no onboarding tour standing between you and a video.</p>
          </div>
          <div class="step">
            <h3>Say your time</h3>
            <p>Ten, twenty, thirty and up — or set your own length exactly.</p>
          </div>
          <div class="step">
            <h3>Watch</h3>
            <p>Something that fits starts playing. If it is not for you, one tap moves on.</p>
          </div>
        </div>

        <div class="lengths" style="margin-top:40px">
          {lengths.map((l) => (
            <div class="len">
              <b>{l.n}<span>{l.unit}</span></b>
              <p>{l.what}</p>
            </div>
          ))}
        </div>
      </section>

      <!--
        The scroll story: the phone stays put and the screen inside it changes
        as the words go by. Six real screens from the current build, one idea
        each — a reader who scrolls once has seen the whole product without
        being asked to read a feature list.

        It degrades to a plain stack under 900px, where a sticky column would
        take the entire viewport and leave nothing to scroll past, and it stops
        moving entirely under prefers-reduced-motion.
      -->
      <section id="story" class="wrap story" aria-labelledby="story-h">
        <h2 id="story-h" class="sr-only">The app, as it actually looks</h2>
        <div class="story-grid">
          <div class="story-copy">
            <article class="panel" data-panel="0">
              <h3>How long have you got?</h3>
              <p>Ten minutes, twenty, thirty or more. Say it, and something good is already playing.</p>
              <figure class="panel-shot"><img src={shots.home} width="648" height="1440" loading="lazy" alt="" /></figure>
            </article>
            <article class="panel" data-panel="1">
              <h3>One press, no feed on the way</h3>
              <p>No list to browse first. The pick is made for you, and it plays.</p>
              <figure class="panel-shot"><img src={shots.player} width="648" height="1440" loading="lazy" alt="" /></figure>
            </article>
            <article class="panel" data-panel="2">
              <h3>One player, six platforms</h3>
              <p>Same controls wherever the video comes from — each in its own official embedded player.</p>
              <figure class="panel-shot"><img src={shots.preferences} width="648" height="1440" loading="lazy" alt="" /></figure>
            </article>
            <article class="panel" data-panel="3">
              <h3>A feed that ends</h3>
              <p>Rails you can reach the end of, built from what you actually finish. On purpose.</p>
              <figure class="panel-shot"><img src={shots.discover} width="648" height="1440" loading="lazy" alt="" /></figure>
            </article>
          </div>

          <div class="story-stage" aria-hidden="true">
            <div class="stage-glow"></div>
            <div class="stage-phone">
              <img src={shots.home} width="648" height="1440" data-screen="0" class="on" alt="" />
              <img src={shots.player} width="648" height="1440" data-screen="1" loading="lazy" alt="" />
              <img src={shots.preferences} width="648" height="1440" data-screen="2" loading="lazy" alt="" />
              <img src={shots.discover} width="648" height="1440" data-screen="3" loading="lazy" alt="" />
            </div>
          </div>
        </div>
      </section>

      <section class="wrap">
        <h2>Six platforms, one player</h2>
        <p class="sub">
          Everything plays inside the app, in each platform’s own official embedded player — so the
          controls, the seek bar and where you left off work the same everywhere.
        </p>
        <div class="rail">{platforms.map((p) => <span class="chip">{p}</span>)}</div>
      </section>

      <section class="wrap">
        <h2>What makes it different</h2>
        <p class="sub">Six things, each of which the app actually does today.</p>
        <div class="grid">
          {features.map((f) => (
            <article class="card">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- The app, working, in one take.
           After "how it works" and before the closing ask: a reader who has
           just been told it takes three seconds should be able to watch that
           being true rather than take our word for it.
           `preload="none"` and no autoplay — a ninety-second file must not
           download itself for somebody who never scrolls here, and the hero
           above is already carrying the page's largest paint. -->
      <section id="film" class="wrap film" aria-labelledby="film-h">
        <h2 id="film-h">Watch it happen</h2>
        <p class="sub">
          Ninety seconds of the real build, in one take: opening it, choosing a
          length, a video playing in YouTube's own player, and the rails it
          builds from what you actually watch.
        </p>
        <div class="film-frame">
          <video
            src="/munchview/film.mp4"
            poster="/munchview/shots/demo-poster.webp"
            width="648"
            height="1440"
            controls
            playsinline
            preload="none"
            aria-label="A ninety-second screen recording of Munchview: the home screen asking how long you have, choosing a length, pressing watch, a video playing in the official YouTube player, the recommendation rails, and the settings screens."
          ></video>
        </div>
      </section>

      <section class="wrap close">
        <h2>Say how long you’ve got.</h2>
        <div class="cta" style="justify-content:center">
          {SIGN_IN_READY ? (
            <a class="btn" href="/signin" data-signed-in-swap>Sign in</a>
          ) : null}
          <a class={SIGN_IN_READY ? 'btn ghost' : 'btn'} href={PLAY_URL}>
            {LIVE ? 'Get it on Google Play' : 'Join the closed test'}
          </a>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap foot-in">
        <span>© 2026 DeftDay Studio</span>
        <span class="spacer"></span>
        <a href="https://deftday.com/munchview/privacy">Privacy</a>
        <a href="https://deftday.com/munchview/terms">Terms</a>
        <a href="https://deftday.com/munchview/delete-account">Delete your account</a>
        <a href="https://deftday.com">DeftDay</a>
      </div>
    </footer>
    <script is:inline>
      /* The screen follows whichever panel is being READ, so the trigger line
         sits at the middle of the viewport rather than at its edge. An observer
         rather than a scroll handler: the browser reports the crossing, and the
         page never measures geometry on a scroll frame. */
      (function () {
        var panels = document.querySelectorAll('.panel[data-panel]');
        var screens = document.querySelectorAll('.stage-phone img[data-screen]');
        if (!panels.length || !('IntersectionObserver' in window)) {
          panels.forEach(function (p) { p.classList.add('on'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            var i = e.target.getAttribute('data-panel');
            panels.forEach(function (p) { p.classList.toggle('on', p === e.target); });
            screens.forEach(function (s) { s.classList.toggle('on', s.getAttribute('data-screen') === i); });
          });
        }, { rootMargin: '-45% 0px -45% 0px', threshold: 0 });
        panels.forEach(function (p) { io.observe(p); });
      })();

      /*
       * Somebody already signed in should not be invited to sign in again.
       *
       * The page is static and cached, so this cannot be decided at build
       * time — it is decided in the browser, from the same key /watch reads.
       * Nothing is validated here and nothing needs to be: the worst case is
       * a link to /watch, which checks the session properly and offers a
       * sign-in if it has expired.
       */
      (function () {
        var session = null;
        try {
          session = localStorage.getItem('mv_session');
        } catch (e) {
          return;
        }
        if (!session) return;
        var links = document.querySelectorAll('[data-signed-in-swap]');
        for (var i = 0; i < links.length; i += 1) {
          links[i].setAttribute('href', '/watch');
          links[i].textContent = 'Watch';
        }
      })();
    </script>
  </body>
</html>
