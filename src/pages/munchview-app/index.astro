---
/**
 * munchview.app — the app's own front door.
 *
 * Redesigned 2026-08-22. The first version borrowed JustWatch's cinema look;
 * the owner didn't warm to it and asked for a page that matches the app
 * ("bu uygulama ile uyumlu"). So the page now IS the app, blown up:
 *
 * - It opens the way the app opens — "WHAT TO WATCH:" with a suggestion chip,
 *   then the question the whole product is built on, then the length row,
 *   then one big amber button. A visitor who later installs the app finds a
 *   home screen they have already met.
 * - The section headings borrow the store screenshots' caption style — first
 *   line white, second line amber — set in Jost, an OFL geometric that reads
 *   like the Futura those captions are set in. Self-hosted (~26 KB, latin);
 *   the CSP allows no font CDNs and should stay that way.
 * - Every screenshot is a whole screen from the current release build,
 *   captured today, in the same device slab the store tablet frames use.
 *
 * Everything on this page is the app's own: colours are the tokens from
 * munchview/src/theme/tokens.ts, the mark is the icon's foreground layer,
 * the Pro list is the app's Pro sheet verbatim (pro-truth rule: the benefits
 * list always matches the shipped gates).
 *
 * Status text comes from ../../config/munchview so this page cannot outlive
 * a track change the way five other surfaces once nearly did.
 */
import { LIVE, PLAY_URL, SIGN_IN_READY } from '../../config/munchview';

const site = 'https://munchview.app';

/* The app's own three presets, captions and all. Display only — a row of
   "controls" that controlled nothing would be a small lie. The middle one
   carries the selected state, like the screenshot beside it. */
const lengths = [
  { n: '10', unit: 'min', what: 'a coffee, a queue, a bus stop', on: false },
  { n: '20', unit: 'min', what: 'lunch at your desk', on: true },
  { n: '30+', unit: 'min', what: 'the sofa, properly', on: false },
];

/* What the suggestion chip cycles through — the moments from the app's own
   store copy, not invented occasions. */
const moments = ['a lunch break', 'a study session', 'the workshop', 'winding down'];

const platforms = ['YouTube', 'Vimeo', 'Dailymotion', 'Twitch', 'PeerTube', 'Internet Archive'];

/* The app's Pro sheet, verbatim. If this drifts from the shipped gates the
   pro-truth rule is being broken on a marketing page, which is worse. */
const pro = [
  'Your own keyword tags — name it, the feed finds it',
  'Browse any country’s feed, in its own language',
  'Any length you like — a bar from 1 to 90 minutes, not three presets',
  'Multiple taste profiles — one phone, everyone who uses it',
  'See where you stopped and how much is left, right on the card',
];

/* The languages the app actually ships, each in its own name. */
const languages = [
  'English', 'Türkçe', 'Deutsch', 'Español', 'Français', 'Italiano',
  'Русский', 'العربية', '日本語', '简体中文', '繁體中文',
];

/* Whole screens from today's release build, one idea each. */
const shots = {
  home: '/munchview/shots/v2-home.webp',
  player: '/munchview/shots/v2-player.webp',
  corner: '/munchview/shots/v2-corner.webp',
  discover: '/munchview/shots/v2-discover.webp',
  platforms: '/munchview/shots/v2-platforms.webp',
  pro: '/munchview/shots/v2-pro.webp',
};

const story = [
  {
    id: 'player',
    w: 'One press.',
    a: 'No feed on the way.',
    body: 'The pick is made before you’ve sat down, and it’s already playing. Not for you? One tap moves on.',
    shot: shots.player,
    alt: 'A Champions League final playing in Munchview, with a related list under it.',
  },
  {
    id: 'corner',
    w: 'Keep it playing,',
    a: 'in the corner.',
    body: 'Pull the video down and it shrinks to a little window that keeps playing while you look around the rest of the app.',
    shot: shots.corner,
    alt: 'Munchview’s home screen with a small corner window still playing a video.',
  },
  {
    id: 'discover',
    w: 'A feed that ends.',
    a: 'On purpose.',
    body: 'Short rails built from what you actually finish — never an infinite scroll, never an autoplay tunnel.',
    shot: shots.discover,
    alt: 'Munchview’s discover rails: Just Slide and You might also like.',
  },
  {
    id: 'platforms',
    w: 'Six platforms.',
    a: 'One player.',
    body: 'YouTube, Vimeo, Dailymotion, Twitch, PeerTube and the Internet Archive — each in its own official embedded player, inside the app.',
    shot: shots.platforms,
    alt: 'Munchview’s platforms screen: six platform cards, all switched on.',
  },
];

/* Structured data. Google reads this to build the app result; every field is
   true of the listing it describes, the same rule the store copy is held to. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: 'Munchview',
  operatingSystem: 'Android',
  applicationCategory: 'EntertainmentApplication',
  url: site,
  installUrl: PLAY_URL,
  image: `${site}/munchview/brand/icon-512.png`,
  screenshot: `${site}/munchview/shots/v2-home.webp`,
  description:
    'Say how long you have and a good video starts playing. Six platforms, one player, no feed.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'DeftDay Studio', url: 'https://deftday.com' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Munchview — say how long you have, and watch</title>
    <meta
      name="description"
      content="Munchview starts a good video that fits the time you have — ten minutes, twenty, an hour. Six platforms, one player, no feed. Free on Google Play."
    />
    <meta name="theme-color" content="#0E101A" />
    <link rel="canonical" href={`${site}/`} />

    <link rel="icon" href="/munchview/brand/icon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/munchview/brand/icon-180.png" />
    <link
      rel="preload"
      href="/munchview/font/jost.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:site_name" content="Munchview" />
    <meta property="og:title" content="Munchview — say how long you have, and watch" />
    <meta
      property="og:description"
      content="A good video that fits the time you have. Six platforms, one player, no feed."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:image" content={`${site}/munchview/brand/og-card.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Munchview — say how long you have, and watch" />
    <meta
      name="twitter:description"
      content="A good video that fits the time you have. Six platforms, one player, no feed."
    />
    <meta name="twitter:image" content={`${site}/munchview/brand/og-card.png`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      /* Set before paint, and only where the reveal can actually be undone
         again: without IntersectionObserver the CSS above never hides
         anything, so an old browser gets the whole page at once rather than
         a blank one. */
      if ('IntersectionObserver' in window) {
        document.documentElement.classList.add('reveal-ready');
      }
    </script>
    <style>
      /* Jost — an OFL geometric close enough to the Futura the store captions
         are set in that the site and the screenshots read as one voice.
         Self-hosted; the CSP allows no font hosts and should stay that way. */
      @font-face {
        font-family: 'Jost';
        font-style: normal;
        font-weight: 400 800;
        font-display: swap;
        src: url('/munchview/font/jost.woff2') format('woff2');
      }

      /* The app's tokens, verbatim. If these ever drift from
         munchview/src/theme/tokens.ts the site is lying about the product. */
      :root {
        --bg: #0e101a;
        --surface: #181b26;
        --surface-high: #222633;
        --line: #232838;
        --accent: #ffb300;
        --accent-pressed: #e09e00;
        --on-accent: #1a1200;
        --ink: #eef2f6;
        --muted: #8d949b;
        --page: 1120px;
        --display: 'Jost', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      }

      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font: 16.5px/1.65 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; }
      img { max-width: 100%; height: auto; display: block; }
      .wrap { width: min(100% - 44px, var(--page)); margin-inline: auto; }
      :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 8px; }
      .sr-only {
        position: absolute; width: 1px; height: 1px;
        overflow: hidden; clip-path: inset(50%); white-space: nowrap;
      }
      .skip { position: absolute; left: -9999px; }
      .skip:focus { left: 16px; top: 12px; z-index: 60; }

      /* ---------- nav ---------- */
      .nav {
        position: sticky; top: 0; z-index: 40;
        background: rgba(14, 16, 26, .92);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(35, 40, 56, .6);
      }
      .nav-in { display: flex; align-items: center; gap: 18px; height: 66px; }
      .brand {
        display: flex; align-items: center; gap: 11px; text-decoration: none;
        font-family: var(--display); font-weight: 600; font-size: 17px; letter-spacing: .14em;
        text-transform: uppercase;
      }
      .brand img { width: 30px; height: 30px; }
      .nav .spacer { flex: 1; }
      .nav a.quiet {
        color: var(--muted); text-decoration: none; font-size: 14.5px;
      }
      .nav a.quiet:hover { color: var(--ink); }
      .pill {
        display: inline-flex; align-items: center; justify-content: center;
        background: var(--accent); color: var(--on-accent);
        font-family: var(--display); font-weight: 700; font-size: 14.5px; letter-spacing: .04em;
        border-radius: 100px; padding: 10px 20px; min-height: 42px; text-decoration: none;
      }
      .pill:hover { background: var(--accent-pressed); }

      /* ---------- the app-button ----------
         The product's signature control: a small tracked line above one big
         word, on amber. The site's version says what it honestly does. */
      .watch-btn {
        display: inline-flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 2px; background: var(--accent); color: var(--on-accent);
        border-radius: 26px; padding: 18px 46px 20px; min-width: 300px;
        text-decoration: none; text-align: center;
        box-shadow: 0 18px 50px rgba(255, 179, 0, .22), 0 4px 14px rgba(0, 0, 0, .5);
        transition: transform .16s ease, box-shadow .16s ease, background .16s ease;
      }
      .watch-btn:hover {
        background: var(--accent-pressed); transform: translateY(-1px);
        box-shadow: 0 22px 60px rgba(255, 179, 0, .26), 0 6px 16px rgba(0, 0, 0, .5);
      }
      .watch-btn .press {
        font-family: var(--display); font-weight: 600; font-size: 12.5px; letter-spacing: .34em;
        text-transform: uppercase; opacity: .78; text-indent: .34em;
      }
      .watch-btn .word {
        font-family: var(--display); font-weight: 800; font-size: clamp(22px, 2.6vw, 28px);
        letter-spacing: .1em; text-transform: uppercase; text-indent: .1em; line-height: 1.15;
      }

      /* ---------- hero ---------- */
      .hero { position: relative; overflow: clip; }
      .hero::before {
        content: ''; position: absolute; inset: -20% -20% auto;
        height: 130%; pointer-events: none;
        background:
          radial-gradient(46% 42% at 76% 30%, rgba(255, 179, 0, .16), transparent 68%),
          radial-gradient(34% 30% at 10% 4%, rgba(84, 110, 255, .12), transparent 62%);
        filter: blur(4px);
      }
      .hero-in {
        position: relative;
        display: grid; grid-template-columns: 1.08fr .92fr; gap: 48px; align-items: center;
        padding: 84px 0 92px;
      }
      .eyebrow {
        display: flex; flex-wrap: wrap; align-items: center; gap: 12px;
        margin: 0 0 26px;
        font-family: var(--display); font-weight: 600; font-size: 14px;
        letter-spacing: .3em; text-transform: uppercase; color: var(--accent);
      }
      .chip-swap {
        display: inline-flex; align-items: center;
        border: 1.5px solid rgba(255, 179, 0, .75);
        border-radius: 100px; padding: 7px 18px;
        font-family: var(--display); font-weight: 500; font-size: 15px;
        letter-spacing: .02em; text-transform: none; color: var(--ink);
        min-width: 172px; justify-content: center;
      }
      .chip-swap span { transition: opacity .3s ease; }
      .chip-swap span.out { opacity: 0; }
      h1 {
        margin: 0 0 22px;
        font-family: var(--display); font-weight: 700;
        font-size: clamp(46px, 7.2vw, 86px);
        line-height: .98; letter-spacing: -.02em;
      }
      .lede {
        margin: 0 0 34px; color: var(--muted); max-width: 46ch;
        font-size: clamp(16.5px, 1.5vw, 19px);
      }
      .lede strong { color: var(--ink); font-weight: 600; }

      .lengths { display: flex; flex-wrap: wrap; gap: 12px; margin: 0 0 36px; }
      .len {
        flex: 1 1 150px; max-width: 190px;
        background: var(--surface);
        border: 1.5px solid var(--line); border-radius: 20px;
        padding: 14px 18px 13px;
      }
      .len b {
        display: block;
        font-family: var(--display); font-weight: 700; font-size: 27px;
        line-height: 1.05; letter-spacing: -.01em;
      }
      .len b span { font-size: 14px; color: var(--muted); font-weight: 600; margin-left: 3px; }
      .len p { margin: 3px 0 0; color: var(--muted); font-size: 13px; line-height: 1.4; }
      .len.on { border-color: var(--accent); }
      .len.on b span { color: var(--accent); }

      .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; }
      .cta small { color: var(--muted); font-size: 14px; line-height: 1.5; }

      /* the device slab, from the store tablet frames */
      .stage { position: relative; justify-self: center; }
      .stage-glow {
        position: absolute; inset: 50% auto auto 50%; transform: translate(-50%, -50%);
        width: min(620px, 86vw); aspect-ratio: 1; border-radius: 50%; pointer-events: none;
        background: radial-gradient(closest-side, rgba(255, 179, 0, .17), rgba(255, 179, 0, .05) 46%, transparent 72%);
        filter: blur(8px);
      }
      .slab {
        position: relative; width: min(316px, 76vw); aspect-ratio: 648 / 1440;
        padding: 10px; border-radius: 40px;
        background: linear-gradient(155deg, #3b4058, #0a0c14 26% 74%, #3b4058);
        box-shadow:
          inset 0 3px 8px rgba(255, 255, 255, .18),
          0 44px 90px rgba(0, 0, 0, .55),
          0 12px 28px rgba(0, 0, 0, .45);
      }
      .slab img { width: 100%; height: 100%; border-radius: 30px; object-fit: cover; }

      /* ---------- proof strip ---------- */
      .proof { padding: 0 0 8px; }
      .proof-in {
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px;
      }
      .stat {
        background: var(--surface); border: 1px solid var(--line); border-radius: 20px;
        padding: 22px 24px 20px;
      }
      .stat b {
        display: block; font-family: var(--display); font-weight: 700;
        font-size: 40px; line-height: 1; letter-spacing: -.01em; color: var(--accent);
      }
      .stat p { margin: 7px 0 0; color: var(--muted); font-size: 14.5px; }

      /* ---------- shared section bits ---------- */
      section { padding: 104px 0 0; }
      .cap {
        margin: 0 0 14px;
        font-family: var(--display); font-weight: 700;
        font-size: clamp(30px, 4.4vw, 52px); line-height: 1.02; letter-spacing: -.02em;
      }
      .cap .a { display: block; color: var(--accent); }
      .sub { margin: 0 0 40px; color: var(--muted); max-width: 58ch; font-size: 17px; }

      /* ---------- story ---------- */
      .story-grid {
        display: grid; grid-template-columns: 1fr 1fr;
        gap: clamp(28px, 5vw, 80px); align-items: start;
      }
      .panel {
        min-height: 72vh; display: flex; flex-direction: column; justify-content: center;
        opacity: .3; transition: opacity .4s ease;
      }
      .panel.on { opacity: 1; }
      .panel h3 {
        margin: 0;
        font-family: var(--display); font-weight: 700;
        font-size: clamp(30px, 3.6vw, 46px); line-height: 1.04; letter-spacing: -.02em;
      }
      .panel h3 .a { display: block; color: var(--accent); }
      .panel p {
        margin: 16px 0 0; color: var(--muted);
        font-size: clamp(15.5px, 1.6vw, 18.5px); max-width: 36ch;
      }
      .panel-shot { display: none; margin: 28px 0 0; }
      .story-stage {
        position: sticky; top: 11vh; height: 78vh;
        display: flex; align-items: center; justify-content: center;
      }
      .story-stage .slab img {
        position: absolute; inset: 10px; width: calc(100% - 20px); height: calc(100% - 20px);
        opacity: 0; transform: scale(1.012);
        transition: opacity .45s ease, transform .45s ease;
      }
      .story-stage .slab img.on { opacity: 1; transform: none; }

      /* ---------- platform cards (the app's own screen) ---------- */
      .plat-grid {
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; max-width: 780px;
      }
      .plat {
        background: #fff; color: #14161f;
        border-radius: 18px; padding: 20px 14px;
        font-family: var(--display); font-weight: 700; font-size: 16.5px; letter-spacing: .01em;
        text-align: center;
      }
      .plat-note { margin: 22px 0 0; color: var(--muted); font-size: 15px; max-width: 58ch; }
      .plat-note b { color: var(--ink); font-weight: 600; }

      /* ---------- languages ---------- */
      .lang-rail { display: flex; flex-wrap: wrap; gap: 10px; max-width: 820px; }
      .lang {
        border: 1px solid var(--line); background: var(--surface);
        border-radius: 100px; padding: 9px 18px; font-size: 15px;
      }

      /* ---------- pro ---------- */
      .pro-grid {
        display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(28px, 5vw, 72px);
        align-items: center;
      }
      .pro-title {
        margin: 0 0 8px;
        font-family: var(--display); font-weight: 700; color: var(--accent);
        font-size: clamp(34px, 4.6vw, 54px); line-height: 1; letter-spacing: -.02em;
      }
      .pro-tag { margin: 0 0 30px; color: var(--muted); font-size: 18px; max-width: 40ch; }
      .pro-list { list-style: none; margin: 0 0 28px; padding: 0; display: grid; gap: 15px; }
      .pro-list li { position: relative; padding-left: 38px; font-size: 16.5px; }
      .pro-list li::before {
        content: '✓'; position: absolute; left: 0; top: 1px;
        width: 24px; height: 24px; border-radius: 50%;
        background: var(--accent); color: var(--on-accent);
        font-weight: 800; font-size: 14px; display: grid; place-items: center;
      }
      .pro-fine { color: var(--muted); font-size: 14.5px; margin: 0; max-width: 46ch; }
      .pro-fine b { color: var(--ink); font-weight: 600; }

      /* ---------- film ---------- */
      .film-frame {
        margin: 0; width: min(324px, 76vw); border-radius: 34px; overflow: hidden;
        border: 1px solid var(--line); background: #000;
        box-shadow: 0 34px 80px rgba(0, 0, 0, .5);
      }
      .film-frame video { display: block; width: 100%; height: auto; }
      .film-grid {
        display: grid; grid-template-columns: 1fr auto; gap: clamp(28px, 5vw, 80px);
        align-items: center;
      }

      /* ---------- quiet privacy ---------- */
      .privacy-card {
        border: 1px solid var(--line); border-radius: 20px;
        background: var(--surface); padding: 26px 28px; max-width: 720px;
      }
      .privacy-card h2 {
        margin: 0 0 10px; font-family: var(--display); font-weight: 700;
        font-size: 19px; letter-spacing: .01em;
      }
      .privacy-card p { margin: 0; color: var(--muted); font-size: 15.5px; }
      .privacy-card a { color: var(--ink); }

      /* ---------- close + footer ---------- */
      .close { text-align: center; padding: 120px 0 110px; }
      .close .cap { margin-bottom: 34px; }
      footer {
        border-top: 1px solid var(--line);
        padding: 36px 0 52px; color: var(--muted); font-size: 14px;
      }
      .foot-in { display: flex; flex-wrap: wrap; gap: 8px 22px; align-items: center; }
      footer a { color: var(--muted); text-decoration: none; }
      footer a:hover { color: var(--ink); text-decoration: underline; }
      footer .spacer { flex: 1; }

      /* ---------- responsive ---------- */
      @media (max-width: 980px) {
        .hero-in { grid-template-columns: 1fr; gap: 52px; padding: 56px 0 72px; }
        .stage { justify-self: center; }
        .proof-in { grid-template-columns: 1fr; }
        .story-grid { grid-template-columns: 1fr; }
        .story-stage { display: none; }
        .panel { min-height: 0; opacity: 1; padding: clamp(34px, 7vh, 64px) 0; }
        .panel-shot { display: flex; justify-content: center; }
        .panel-shot img { width: min(280px, 72vw); border-radius: 26px; }
        .pro-grid { grid-template-columns: 1fr; }
        .film-grid { grid-template-columns: 1fr; }
        .film-frame { margin-inline: auto; }
        section { padding-top: 84px; }
      }
      @media (max-width: 720px) {
        /* Brand + one button. The quiet links all have in-page homes —
           story, Pro, the footer's privacy — and a nav that wraps to three
           lines is worse than a nav with less in it. */
        .nav a.quiet { display: none; }
      }
      @media (max-width: 560px) {
        .plat-grid { grid-template-columns: repeat(2, 1fr); }
        .watch-btn { width: 100%; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        * { transition: none !important; animation: none !important; }
        .panel { opacity: 1; }
      }

      /* ── Arriving as you reach it ──────────────────────────────────────
         Restraint first: one movement, always the same one — a short rise
         and a fade, never a slide from the side, never a scale on a block of
         text. Motion here has one job, which is to say "this is the part you
         have got to", and a page that does six different things while you
         scroll is a page you stop reading.

         The rise is 16px. Far enough to register at the edge of vision,
         short enough that nobody has to wait for it. The curve settles
         without overshoot — the equivalent of a critically damped spring,
         because nothing here was thrown by a finger, and bounce on a
         paragraph that simply appeared reads as decoration.

         The hero and the nav are deliberately exempt. The first screen must
         be readable the instant it paints, and a sticky bar that starts
         invisible is a bar that is missing — both were caught by reading the
         selector against the markup before this shipped, not after.

         The hidden state only exists under `.reveal-ready`, a class set in
         the head — so a browser without IntersectionObserver, or with
         scripting off, is never left holding an invisible page.

         `:global()` on that class is load-bearing, not decoration. Astro
         scopes every selector in this block by appending its own attribute,
         and the class lives on <html>, which has no such attribute — so the
         first version of these rules compiled to something that could never
         match anything and the whole system was dead in the build while the
         source looked correct. Caught by reading dist/, not the source. */
      @media (prefers-reduced-motion: no-preference) {
        :global(html.reveal-ready) .wrap:not(.hero-in):not(.nav-in) > *,
        :global(html.reveal-ready) .plat-grid > .plat,
        :global(html.reveal-ready) .lang-rail > .lang {
          transition:
            opacity 620ms cubic-bezier(.22, 1, .36, 1),
            transform 620ms cubic-bezier(.22, 1, .36, 1);
          transition-delay: calc(var(--i, 0) * 55ms);
        }
        :global(html.reveal-ready) .wrap:not(.hero-in):not(.nav-in) > *:not(.in) {
          opacity: 0;
          transform: translateY(16px);
        }
        /* The six marks and the eleven languages arrive as a group rather
           than as one block: a shorter rise and a hair of scale, so the row
           reads as items landing rather than a panel sliding. */
        :global(html.reveal-ready) .plat-grid > .plat:not(.in),
        :global(html.reveal-ready) .lang-rail > .lang:not(.in) {
          opacity: 0;
          transform: translateY(10px) scale(.985);
        }
      }

      /* Reduced motion keeps the arrival and drops the travel — the cue
         survives, the vestibular cost does not. */
      @media (prefers-reduced-motion: reduce) {
        :global(html.reveal-ready) .wrap:not(.hero-in):not(.nav-in) > * { transition: opacity 300ms linear; }
        :global(html.reveal-ready) .wrap:not(.hero-in):not(.nav-in) > *:not(.in) { opacity: 0; transform: none; }
      }
    </style>
  </head>

  <body>
    <a class="skip pill" href="#main">Skip to content</a>

    <nav class="nav" aria-label="Site">
      <div class="wrap nav-in">
        <a class="brand" href="/">
          <img src="/munchview/brand/mark-96.png" width="30" height="30" alt="" />
          Munchview
        </a>
        <span class="spacer"></span>
        <a class="quiet" href="#story">How it works</a>
        <a class="quiet" href="#pro">Pro</a>
        <a class="quiet" href="https://deftday.com/munchview/privacy">Privacy</a>
        <a class="pill" href={PLAY_URL}>Get it on Play</a>
      </div>
    </nav>

    <header class="hero">
      <div class="wrap hero-in">
        <div>
          <p class="eyebrow">
            What to watch:
            <span class="chip-swap" aria-hidden="true"><span id="moment">{moments[0]}</span></span>
            <span class="sr-only">whatever moment you’re in — a lunch break, a study session, winding down.</span>
          </p>

          <h1>How long<br />have you got?</h1>

          <p class="lede">
            Say the time — ten minutes, an hour — and a good video is
            <strong>already playing</strong> when the screen lights up.
            No feed to fall into. No account to make.
          </p>

          <div class="lengths" aria-hidden="true">
            {lengths.map((l) => (
              <div class={l.on ? 'len on' : 'len'}>
                <b>{l.n}<span>{l.unit}</span></b>
                <p>{l.what}</p>
              </div>
            ))}
          </div>

          <div class="cta">
            <a class="watch-btn" href={PLAY_URL}>
              <span class="press">{LIVE ? 'Free on Google Play' : 'Closed test'}</span>
              <span class="word">Get the app</span>
            </a>
            <small>Android · Free<br />Pro if you want it</small>
          </div>
        </div>

        <div class="stage">
          <div class="stage-glow" aria-hidden="true"></div>
          <div class="slab">
            <img
              src={shots.home}
              width="648"
              height="1440"
              alt="Munchview’s home screen: the question “How long have you got?”, the watching-preferences pill, and one large amber button that says PRESS TO WATCH."
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </header>

    <main id="main">
      <div class="proof wrap">
        <div class="proof-in">
          <div class="stat"><b>3 s</b><p>from opening the app to watching</p></div>
          <div class="stat"><b>6</b><p>platforms, playing in one calm player</p></div>
          <div class="stat"><b>0</b><p>trackers or analytics — the learning stays on your phone</p></div>
        </div>
      </div>

      <section id="story" aria-label="How Munchview works">
        <div class="wrap story-grid">
          <div>
            {story.map((s, i) => (
              <article class="panel" data-panel={String(i)}>
                <h3>{s.w}<span class="a">{s.a}</span></h3>
                <p>{s.body}</p>
                <figure class="panel-shot">
                  <img src={s.shot} width="648" height="1440" loading="lazy" alt={s.alt} />
                </figure>
              </article>
            ))}
          </div>
          <div class="story-stage" aria-hidden="true">
            <div class="stage-glow"></div>
            <div class="slab">
              {story.map((s, i) => (
                <img
                  src={s.shot}
                  width="648"
                  height="1440"
                  data-screen={String(i)}
                  class={i === 0 ? 'on' : ''}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  alt=""
                />
              ))}
            </div>
          </div>
        </div>
      </section>

      <section aria-labelledby="plat-h">
        <div class="wrap">
          <h2 class="cap" id="plat-h">Everything is on<span class="a">unless you say otherwise.</span></h2>
          <p class="sub">
            That line is from the app’s own platforms screen. Turn any of the six off and
            the feed follows; leave them all on and it simply plays the best thing it has.
          </p>
          <div class="plat-grid">
            {platforms.map((p) => <div class="plat">{p}</div>)}
          </div>
          <p class="plat-note">
            Each platform plays in its <b>own official embedded player</b>, inside the app.
            Their players are their own — including any ads they run. We put none in.
          </p>
        </div>
      </section>

      <section aria-labelledby="lang-h">
        <div class="wrap">
          <h2 class="cap" id="lang-h">Eleven languages.<span class="a">Your country’s own feed.</span></h2>
          <p class="sub">
            The feed is your country’s, searched in its own language — not in English with a
            flag on it. Pro can browse every other country’s feed the same way.
          </p>
          <div class="lang-rail">
            {languages.map((l) => <span class="lang">{l}</span>)}
          </div>
        </div>
      </section>

      <section id="pro" aria-labelledby="pro-h">
        <div class="wrap pro-grid">
          <div>
            <h2 class="pro-title" id="pro-h">Munchview Pro</h2>
            <p class="pro-tag">Everything you watch while you’re doing something else.</p>
            <ul class="pro-list">
              {pro.map((p) => <li>{p}</li>)}
            </ul>
            <p class="pro-fine">
              Monthly, yearly or lifetime — priced in your own currency, in the app.
              <b>The free app is the whole idea; Pro widens it.</b>
            </p>
          </div>
          <div class="stage">
            <div class="stage-glow" aria-hidden="true"></div>
            <div class="slab">
              <img
                src={shots.pro}
                width="648"
                height="1440"
                loading="lazy"
                alt="The Munchview Pro sheet listing keyword tags, country browsing, custom lengths, taste profiles and resume-on-card."
              />
            </div>
          </div>
        </div>
      </section>

      <section id="film" aria-labelledby="film-h">
        <div class="wrap film-grid">
          <div>
            <h2 class="cap" id="film-h">Ninety seconds.<span class="a">One take.</span></h2>
            <p class="sub">
              The real build, unstaged: opening it, choosing a length, a video playing in
              YouTube’s own player, and the rails it builds from what you actually watch.
            </p>
          </div>
          <div class="film-frame">
            <video
              src="/munchview/film.mp4"
              poster="/munchview/shots/demo-poster.webp"
              width="648"
              height="1440"
              controls
              playsinline
              preload="none"
              aria-label="A ninety-second screen recording of Munchview: the home screen asking how long you have, choosing a length, pressing watch, a video playing in the official YouTube player, and the recommendation rails."
            ></video>
          </div>
        </div>
      </section>

      <section aria-label="Privacy, briefly">
        <div class="wrap">
          <div class="privacy-card">
            <h2>What it doesn’t do</h2>
            <p>
              No analytics, no trackers, and no advertising of ours — in either tier. What it
              learns about your taste stays on your phone. The platforms’ own players run
              their own ads; those are theirs, and we’d rather say so than pretend.
              The details live on one page: <a href="https://deftday.com/munchview/privacy">privacy</a>.
            </p>
          </div>
        </div>
      </section>

      <section class="close" aria-label="Get Munchview">
        <div class="wrap">
          <h2 class="cap">Say how long<span class="a">you’ve got.</span></h2>
          <div class="cta" style="justify-content:center">
            {SIGN_IN_READY ? (
              <a class="pill" href="/signin" data-signed-in-swap>Sign in</a>
            ) : null}
            <a class="watch-btn" href={PLAY_URL}>
              <span class="press">{LIVE ? 'Free on Google Play' : 'Closed test'}</span>
              <span class="word">Get the app</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap foot-in">
        <span>© 2026 DeftDay Studio</span>
        <span class="spacer"></span>
        <a href="https://deftday.com/munchview/privacy">Privacy</a>
        <a href="https://deftday.com/munchview/terms">Terms</a>
        <a href="https://deftday.com/munchview/delete-account">Delete your account</a>
        <a href="https://deftday.com">DeftDay</a>
      </div>
    </footer>

    <script is:inline>
      /* The suggestion chip, cycling the same moments the app's store copy
         names. Decorative — the real text for readers and screen readers is
         the static sr-only sentence beside it — and it holds still for
         anyone who asked for reduced motion. */
      (function () {
        var el = document.getElementById('moment');
        if (!el || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var moments = ['a lunch break', 'a study session', 'the workshop', 'winding down'];
        var i = 0;
        setInterval(function () {
          el.classList.add('out');
          setTimeout(function () {
            i = (i + 1) % moments.length;
            el.textContent = moments[i];
            el.classList.remove('out');
          }, 300);
        }, 2800);
      })();

      /* The screen follows whichever panel is being READ, so the trigger line
         sits at the middle of the viewport rather than at its edge. An observer
         rather than a scroll handler: the browser reports the crossing, and the
         page never measures geometry on a scroll frame. */
      (function () {
        var panels = document.querySelectorAll('.panel[data-panel]');
        var screens = document.querySelectorAll('.story-stage img[data-screen]');
        if (!panels.length || !('IntersectionObserver' in window)) {
          panels.forEach(function (p) { p.classList.add('on'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            var i = e.target.getAttribute('data-panel');
            panels.forEach(function (p) { p.classList.toggle('on', p === e.target); });
            screens.forEach(function (s) { s.classList.toggle('on', s.getAttribute('data-screen') === i); });
          });
        }, { rootMargin: '-45% 0px -45% 0px', threshold: 0 });
        panels.forEach(function (p) { io.observe(p); });
      })();

      /*
       * Somebody already signed in should not be invited to sign in again.
       * Decided in the browser from the same key /watch reads; the worst case
       * is a link to /watch, which checks the session properly.
       */
      (function () {
        var session = null;
        try { session = localStorage.getItem('mv_session'); } catch (e) { return; }
        if (!session) return;
        var links = document.querySelectorAll('[data-signed-in-swap]');
        for (var i = 0; i < links.length; i += 1) {
          links[i].setAttribute('href', '/watch');
          links[i].textContent = 'Watch';
        }
      })();

      /* Reveal what the reader has reached, once.
       *
       * An observer rather than a scroll handler, for the same reason the
       * story panels use one: the browser reports the crossing off the main
       * thread, and the page never measures geometry on a scroll frame.
       *
       * Bottom margin of -12% so an element commits when it is properly in
       * the room, not the instant a pixel of it clears the fold — arriving
       * exactly at the edge reads as a glitch rather than as an entrance.
       *
       * Unobserved after it lands. Nothing re-hides on the way back up: a
       * page that replays its entrance every time you scroll past is a page
       * that will not let you re-read a sentence.
       */
      (function () {
        if (!('IntersectionObserver' in window)) return;
        var groups = [
          ['.wrap:not(.hero-in):not(.nav-in) > *', 8],
          ['.plat-grid > .plat', 12],
          ['.lang-rail > .lang', 14],
        ];
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            e.target.classList.add('in');
            io.unobserve(e.target);
          });
        }, { rootMargin: '0px 0px -12% 0px', threshold: 0 });

        groups.forEach(function (g) {
          var sel = g[0];
          var cap = g[1];
          var seen = new Map();
          document.querySelectorAll(sel).forEach(function (el) {
            /* The stagger counts within the element's own container, and is
               capped: the eleventh language should not wait three times as
               long as the first to say the same thing. */
            var parent = el.parentElement;
            var n = seen.get(parent) || 0;
            seen.set(parent, n + 1);
            el.style.setProperty('--i', String(Math.min(n, cap)));
            io.observe(el);
          });
        });
      })();
    </script>
  </body>
</html>
