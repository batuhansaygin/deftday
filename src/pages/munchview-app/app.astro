---
/**
 * munchview.app/app — what a signed-in reader sees.
 *
 * The same record the phone reads, not a copy of it: this asks /sync with the
 * session the pairing handed over, and renders the snapshot the app wrote.
 * Nothing here has its own store, and nothing here writes — the phone is where
 * the taste is built, and a web page that could quietly disagree with it would
 * be a second source of truth for the same person.
 *
 * Rendered in the browser rather than at build time for the obvious reason:
 * there is no reader at build time. The shell, the empty state and the failure
 * states are all in the HTML, so the only thing JavaScript adds is the data.
 */
import { CONTENT_API_URL, PLAY_URL, SITE_URL } from '../../config/munchview';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Your Munchview</title>
    <!-- A signed-in page has nothing to offer a search engine, and the record
         behind it is one person's own. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0E101A" />
    <link rel="canonical" href={`${SITE_URL}/app`} />
    <link rel="icon" href="/munchview/brand/icon-32.png" sizes="32x32" />
    <style>
      :root {
        --bg: #0e101a; --surface: #181b26; --high: #222633; --line: #222633;
        --accent: #ffb300; --ink: #eef2f6; --muted: #8d949b;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; min-height: 100dvh; background: var(--bg); color: var(--ink);
        font: 16px/1.6 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; }
      .wrap { width: min(100%, 1080px); margin: 0 auto; padding: 0 20px; }
      header {
        border-bottom: 1px solid var(--line); padding: 14px 0;
        position: sticky; top: 0; background: rgba(14, 16, 26, .92);
        backdrop-filter: blur(8px); z-index: 5;
      }
      .bar { display: flex; align-items: center; gap: 12px; }
      .brand { display: flex; align-items: center; gap: 9px; font-weight: 800; text-decoration: none; }
      .spacer { flex: 1; }
      .who { display: flex; align-items: center; gap: 9px; font-size: 14px; color: var(--muted); }
      .out {
        background: none; border: 1px solid var(--line); color: var(--muted);
        border-radius: 100px; padding: 8px 16px; min-height: 44px; font: inherit;
        font-size: 14px; cursor: pointer;
      }
      .out:hover { color: var(--ink); border-color: var(--muted); }
      main { padding: 32px 0 64px; }
      h1 { margin: 0 0 6px; font-size: clamp(24px, 4vw, 32px); letter-spacing: -.02em; }
      .sub { margin: 0 0 32px; color: var(--muted); font-size: 15px; }
      section { margin-bottom: 40px; }
      h2 {
        margin: 0 0 14px; font-size: 13px; text-transform: uppercase;
        letter-spacing: .09em; color: var(--muted); font-weight: 700;
      }
      .grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); }
      .card {
        background: var(--surface); border: 1px solid var(--line);
        border-radius: 14px; overflow: hidden; text-decoration: none; display: block;
      }
      .card:hover { border-color: var(--high); }
      .card img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; background: var(--high); }
      .card .meta { padding: 11px 13px 13px; }
      .card .t { font-size: 14.5px; font-weight: 600; line-height: 1.35; margin: 0 0 5px;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .card .c { margin: 0; font-size: 12.5px; color: var(--muted); }
      .chips { display: flex; flex-wrap: wrap; gap: 9px; }
      .chip {
        background: var(--surface); border: 1px solid var(--line); border-radius: 100px;
        padding: 8px 15px; font-size: 14px; color: var(--ink);
      }
      .chip.on { border-color: var(--accent); color: var(--accent); }
      .profiles { display: flex; flex-wrap: wrap; gap: 12px; }
      .profile {
        display: flex; align-items: center; gap: 10px; background: var(--surface);
        border: 1px solid var(--line); border-radius: 12px; padding: 10px 16px; font-size: 15px;
      }
      .profile .e { font-size: 20px; }
      .state { text-align: center; padding: 72px 20px; color: var(--muted); }
      .state h2 { color: var(--ink); font-size: 19px; text-transform: none; letter-spacing: 0; margin-bottom: 8px; }
      .state p { margin: 0 auto 20px; max-width: 46ch; }
      .btn {
        display: inline-flex; align-items: center; justify-content: center;
        background: var(--accent); color: #1a1200; font-weight: 800; text-decoration: none;
        border-radius: 100px; padding: 12px 22px; min-height: 44px; font-size: 15px;
      }
      .btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--line); }
      .empty { color: var(--muted); font-size: 14.5px; margin: 0; }
      footer { border-top: 1px solid var(--line); padding: 22px 0; color: var(--muted); font-size: 13.5px; }
      footer a { color: var(--muted); }
      :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 8px; }
      @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
    </style>
  </head>
  <body data-api={CONTENT_API_URL}>
    <header>
      <div class="wrap bar">
        <a class="brand" href="/">
          <img src="/munchview/brand/mark-96.png" width="26" height="26" alt="" />
          Munchview
        </a>
        <span class="spacer"></span>
        <span class="who" id="who" hidden></span>
        <button class="out" type="button" id="out" hidden>Sign out</button>
      </div>
    </header>

    <main class="wrap">
      <!-- Loading, signed-out, offline and empty are all here in the markup.
           A screen that only knows how to render success is a screen that
           shows a blank page the first time anything goes wrong. -->
      <div class="state" id="loading">
        <h2>Reading your Munchview…</h2>
        <p>One moment.</p>
      </div>

      <div class="state" id="signedout" hidden>
        <h2>You are not signed in here</h2>
        <p>Sign in with your phone and this page fills with what you have watched, liked and saved.</p>
        <a class="btn" href="/signin">Sign in</a>
      </div>

      <div class="state" id="offline" hidden>
        <h2>Could not reach Munchview</h2>
        <p>Your account is fine — this page just could not read it. It is usually the connection.</p>
        <button class="btn ghost" type="button" id="retry">Try again</button>
      </div>

      <div class="state" id="fresh" hidden>
        <h2>Nothing here yet</h2>
        <p>
          This fills up as you watch. Munchview is built for the phone — say how long you have got,
          and something worth watching is already playing.
        </p>
        <a class="btn" href={PLAY_URL}>Get the app</a>
      </div>

      <div id="content" hidden>
        <h1 id="greeting">Your Munchview</h1>
        <p class="sub" id="updated"></p>

        <section id="s-resume" hidden>
          <h2>Carry on watching</h2>
          <div class="grid" id="resume"></div>
        </section>

        <section id="s-history" hidden>
          <h2>Recently watched</h2>
          <div class="grid" id="history"></div>
        </section>

        <section id="s-favorites" hidden>
          <h2>Liked</h2>
          <div class="grid" id="favorites"></div>
        </section>

        <section id="s-profiles" hidden>
          <h2>Profiles</h2>
          <div class="profiles" id="profiles"></div>
        </section>

        <section id="s-interests" hidden>
          <h2>What you watch</h2>
          <div class="chips" id="interests"></div>
        </section>

        <section id="s-tags" hidden>
          <h2>Your tags</h2>
          <div class="chips" id="tags"></div>
        </section>
      </div>
    </main>

    <footer>
      <div class="wrap">
        Read from the same record your phone writes — this page never changes it.
        <a href="/munchview/privacy">Privacy</a> ·
        <a href="https://deftday.com">DeftDay Studio</a>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var api = document.body.getAttribute('data-api');
        var $ = function (id) { return document.getElementById(id); };

        function only(id) {
          ['loading', 'signedout', 'offline', 'fresh', 'content'].forEach(function (s) {
            $(s).hidden = s !== id;
          });
        }

        function session() {
          try { return sessionStorage.getItem('mv_session'); } catch (e) { return null; }
        }

        /* Titles and channel names come from a record this person's own phone
           wrote, but they originate with the platforms — so they are set as
           text, never as HTML. innerHTML here would make a video title a
           scripting vector against the person who watched it. */
        function text(el, value) { el.textContent = value == null ? '' : String(value); }

        function card(video) {
          var a = document.createElement('a');
          a.className = 'card';
          a.href = watchUrl(video);
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          if (video.thumbnailUrl) {
            var img = document.createElement('img');
            img.src = video.thumbnailUrl;
            img.alt = '';
            img.loading = 'lazy';
            a.appendChild(img);
          }
          var meta = document.createElement('div');
          meta.className = 'meta';
          var t = document.createElement('p');
          t.className = 't';
          text(t, video.title);
          var c = document.createElement('p');
          c.className = 'c';
          text(c, video.channelTitle);
          meta.appendChild(t);
          meta.appendChild(c);
          a.appendChild(meta);
          return a;
        }

        /* The id is namespaced by source (`vimeo:12345`), so a link has to be
           built per platform rather than pasted after a YouTube URL — that is
           how a Dailymotion id ends up as a broken YouTube link. */
        function watchUrl(video) {
          var id = String(video.id || '');
          var colon = id.indexOf(':');
          if (colon === -1) return 'https://www.youtube.com/watch?v=' + encodeURIComponent(id);
          var source = id.slice(0, colon);
          var rest = id.slice(colon + 1);
          if (source === 'dailymotion') return 'https://www.dailymotion.com/video/' + encodeURIComponent(rest);
          if (source === 'vimeo') return 'https://vimeo.com/' + encodeURIComponent(rest);
          if (source === 'twitch') return 'https://www.twitch.tv/videos/' + encodeURIComponent(rest);
          return video.embedUrl || '#';
        }

        function fill(gridId, sectionId, videos) {
          if (!videos || videos.length === 0) return;
          var grid = $(gridId);
          grid.textContent = '';
          videos.slice(0, 12).forEach(function (v) { if (v) grid.appendChild(card(v)); });
          $(sectionId).hidden = grid.childElementCount === 0;
        }

        function chips(id, sectionId, values, active) {
          if (!values || values.length === 0) return;
          var box = $(id);
          box.textContent = '';
          values.forEach(function (value) {
            var span = document.createElement('span');
            span.className = active && active.indexOf(value) !== -1 ? 'chip on' : 'chip';
            text(span, value);
            box.appendChild(span);
          });
          $(sectionId).hidden = false;
        }

        function ago(ms) {
          if (!ms) return '';
          var mins = Math.round((Date.now() - ms) / 60000);
          if (mins < 1) return 'Updated just now';
          if (mins < 60) return 'Updated ' + mins + ' minute' + (mins === 1 ? '' : 's') + ' ago';
          var hours = Math.round(mins / 60);
          if (hours < 24) return 'Updated ' + hours + ' hour' + (hours === 1 ? '' : 's') + ' ago';
          var days = Math.round(hours / 24);
          return 'Updated ' + days + ' day' + (days === 1 ? '' : 's') + ' ago';
        }

        function render(snapshot) {
          if (snapshot == null) return only('fresh');

          var history = snapshot.history || [];
          var favorites = snapshot.favorites || [];
          var profiles = snapshot.profiles || [];
          var categories = snapshot.categories || [];
          var tags = snapshot.tags || [];

          /* A record that exists but holds nothing is the same experience as
             no record: an empty page with headings over it reads as broken. */
          if (
            history.length === 0 && favorites.length === 0 &&
            categories.length === 0 && tags.length === 0 && profiles.length <= 1
          ) return only('fresh');

          text($('updated'), ago(snapshot.updatedAt));

          if (snapshot.resume && snapshot.resume.video) {
            fill('resume', 's-resume', [snapshot.resume.video]);
          }
          fill('history', 's-history', history.map(function (h) { return h && h.video; }));
          fill('favorites', 's-favorites', favorites);

          if (profiles.length > 0) {
            var box = $('profiles');
            box.textContent = '';
            profiles.forEach(function (p) {
              var el = document.createElement('span');
              el.className = 'profile';
              var e = document.createElement('span');
              e.className = 'e';
              text(e, p.emoji);
              var n = document.createElement('span');
              text(n, p.name);
              el.appendChild(e);
              el.appendChild(n);
              box.appendChild(el);
            });
            $('s-profiles').hidden = false;
          }

          chips('interests', 's-interests', categories, categories);
          chips('tags', 's-tags', tags, snapshot.activeTags || []);

          only('content');
        }

        function load() {
          var token = session();
          if (!token) return only('signedout');
          only('loading');
          fetch(api + '/sync', { headers: { authorization: 'Bearer ' + token } })
            .then(function (r) {
              if (r.status === 401) {
                /* The session expired or was revoked. Clearing it means the
                   next visit offers a sign-in rather than failing again. */
                try { sessionStorage.removeItem('mv_session'); } catch (e) {}
                only('signedout');
                return null;
              }
              if (!r.ok) throw new Error(String(r.status));
              return r.json();
            })
            .then(function (data) {
              if (data == null) return;
              $('out').hidden = false;
              render(data.snapshot);
            })
            .catch(function () { only('offline'); });
        }

        $('retry').addEventListener('click', load);
        $('out').addEventListener('click', function () {
          try { sessionStorage.removeItem('mv_session'); } catch (e) {}
          window.location.assign('/');
        });

        load();
      })();
    </script>
  </body>
</html>
