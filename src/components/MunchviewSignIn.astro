---
/**
 * "Continue with Google" on munchview.app — the same door as the app's.
 *
 * Google Identity Services rather than a redirect dance: GIS hands back an ID
 * token in the page, which is exactly what /sync wants in its Authorization
 * header. No client secret is involved and none could be — a secret in a
 * browser is not a secret.
 *
 * The token goes to sessionStorage, not localStorage and not a cookie. It dies
 * with the tab, is never sent automatically with a request, and cannot be read
 * cross-origin. Google expires it in about an hour at its end anyway, so the
 * app has to handle that regardless.
 *
 * REQUIRES a Google OAuth client of type "Web application". Munchview's only
 * client is an Android one, which Google will not accept from a browser: it is
 * bound to a package name and a signing certificate and has no authorised
 * JavaScript origin. There is no API that creates one, so the value has to be
 * made by hand in the Google Cloud console and given to the build:
 *
 *   PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com npx astro build
 *
 * and the SAME id appended to the content Worker's GOOGLE_CLIENT_IDS secret,
 * in the same change — that list is the audience /sync checks, and a token
 * minted for a client the Worker has never heard of is refused, which is
 * correct and looks exactly like "sign-in does nothing".
 *
 * Until then this renders nothing and the caller falls back to pairing with
 * the phone. A button that opens a Google dialog and then fails is worse than
 * no button.
 */
import { APP_PATH, GOOGLE_WEB_CLIENT_ID, GOOGLE_READY } from '../config/munchview';

interface Props {
  /** Where to go once Google has answered. */
  next?: string;
}
const { next = APP_PATH } = Astro.props as Props;
---

{
  GOOGLE_READY && (
    <div class="mv-signin">
      <div id="mv-google-btn" data-client-id={GOOGLE_WEB_CLIENT_ID} data-next={next} />
      <noscript>
        <p class="mv-note">
          Signing in needs JavaScript. Everything else on this page works without it.
        </p>
      </noscript>
      <p class="mv-note" id="mv-signin-error" hidden role="alert" />

      <script is:inline src="https://accounts.google.com/gsi/client" async defer />
      <script is:inline>
        (function () {
          var mount = document.getElementById('mv-google-btn');
          if (!mount) return;
          var clientId = mount.getAttribute('data-client-id');
          var next = mount.getAttribute('data-next') || '/app';
          var err = document.getElementById('mv-signin-error');

          function fail(message) {
            if (!err) return;
            err.textContent = message;
            err.hidden = false;
          }

          function onCredential(response) {
            var token = response && response.credential;
            if (!token) return fail('Google did not return a sign-in. Please try again.');
            try {
              sessionStorage.setItem('mv_session', token);
            } catch (e) {
              /* Private mode, or storage switched off. The page can ask again;
                 what it must not do is pretend the sign-in worked. */
              return fail('This browser is blocking storage, so the sign-in cannot be kept.');
            }
            window.location.assign(next);
          }

          /* GIS loads async; wait for it rather than racing it. Ten seconds is
             long enough for a slow network and short enough that a blocked
             script does not leave an empty space with no explanation. */
          var waited = 0;
          var timer = setInterval(function () {
            if (window.google && window.google.accounts && window.google.accounts.id) {
              clearInterval(timer);
              window.google.accounts.id.initialize({
                client_id: clientId,
                callback: onCredential,
                auto_select: false,
                cancel_on_tap_outside: true,
                ux_mode: 'popup',
              });
              window.google.accounts.id.renderButton(mount, {
                theme: 'filled_black',
                size: 'large',
                shape: 'pill',
                text: 'continue_with',
                logo_alignment: 'left',
              });
              return;
            }
            waited += 200;
            if (waited >= 10000) {
              clearInterval(timer);
              fail('Google’s sign-in script did not load. A blocker or a network filter usually explains it.');
            }
          }, 200);
        })();
      </script>
    </div>
  )
}

<style>
  .mv-signin { display: inline-flex; flex-direction: column; gap: 8px; align-items: center; }
  .mv-note { margin: 0; color: #8d949b; font-size: 13.5px; max-width: 42ch; }
</style>
