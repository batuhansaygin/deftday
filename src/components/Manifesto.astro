---
// Studio manifesto — words light up as you scroll.
---

<section id="studio" class="manifesto" aria-labelledby="studio-title">
  <div class="sec-tag"><b>01</b> The Studio</div>
  <h2 id="studio-title" class="visually-hidden">
    An independent app and game studio that designs, builds and ships its own products
  </h2>
  <p id="manifesto-text">
    Small studio. Sharp craft. We design, build and ship our own products — from
    the food that fuels your day to the games that own your night. No
    committees. No filler. Just work we’re proud to put our name on.
  </p>
</section>

<script>
  const man = document.getElementById('manifesto-text');
  if (man) {
    const words = (man.textContent || '').trim().split(/\s+/);
    man.innerHTML = words.map((w) => `<span class="w">${w}</span>`).join(' ');
    const manWords = man.querySelectorAll<HTMLElement>('.w');
    let lit = -1;
    let ticking = false;

    /* Reading getBoundingClientRect() inside the scroll handler forces a
       layout on every event. Sample it once per animation frame instead, and
       only touch the DOM when the number of lit words actually changes. */
    function light() {
      ticking = false;
      const r = man!.getBoundingClientRect();
      const vh = window.innerHeight;
      const progress = Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (r.height + vh * 0.35)));
      const count = Math.floor(progress * manWords.length);
      if (count === lit) return;
      manWords.forEach((w, i) => w.classList.toggle('on', i < count));
      lit = count;
    }
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(light);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    /* Batched, not immediate: measuring right after the innerHTML write above
       would force a synchronous layout during page load. */
    onScroll();
  }
</script>
