---
// In the lab — upcoming products with living phone mockups.
---

<section id="lab" aria-labelledby="lab-title">
  <div class="sec-tag"><b>03</b> In the lab</div>
  <h2 id="lab-title" class="rv">Now brewing at <span class="serif">DeftDay.</span></h2>

  <div class="lab-row">
    <div class="rv">
      <span class="badge">Coming 2026</span>
      <span class="cat">Productivity — iOS &amp; Android</span>
      <h3>Project Dawn</h3>
      <p>
        A daily planner that starts working before you do. Plan tomorrow in
        ninety seconds tonight, wake up to a day that already makes sense.
      </p>
    </div>
    <div class="phone-wrap rv d1">
      <div class="phone">
        <div class="screen dawn">
          <div class="sunball" aria-hidden="true"></div>
          <span class="app">Dawn</span>
          <span class="sub">Tomorrow, planned</span>
          <div class="todo" aria-hidden="true">
            <div class="t done"><i>✓</i><span></span></div>
            <div class="t done"><i>✓</i><span></span></div>
            <div class="t"><i></i><span></span></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="lab-row flip">
    <div class="rv">
      <span class="badge">In development</span>
      <span class="cat">Game — iOS &amp; Android</span>
      <h3>Project Nightshift</h3>
      <p>
        An arcade game for the hours after the to-do list is done. One thumb,
        one rule, impossible to put down.
      </p>
    </div>
    <div class="phone-wrap rv d1">
      <div class="phone">
        <div class="screen night">
          <div class="stars" aria-hidden="true"></div>
          <span class="app">Nightshift</span>
          <span class="sub">Wave 07</span>
          <div class="arcade" aria-hidden="true">
            <div class="score">×<b id="ns-score">2 048</b></div>
            <div class="track"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="lab-row">
    <div class="rv">
      <span class="badge">Concept</span>
      <span class="cat">Utility — iOS &amp; Android</span>
      <h3>Project Pocket</h3>
      <p>
        The tiny tool you'll reach for ten times a day. Details under wraps —
        the good kind of small.
      </p>
    </div>
    <div class="phone-wrap rv d1">
      <div class="phone">
        <div class="screen pocket">
          <span class="app">Pocket</span>
          <span class="sub">Always ready</span>
          <div class="toggles" aria-hidden="true">
            <div class="g on"><span></span><i></i></div>
            <div class="g"><span></span><i></i></div>
            <div class="g on"><span></span><i></i></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="numbers">
    <div class="rv"><div class="n" data-count="2">0</div><div class="l">Platforms, day one</div></div>
    <div class="rv d1"><div class="n" data-count="3">0</div><div class="l">Products in flight</div></div>
    <div class="rv d2"><div class="n" data-count="100">0</div><div class="l">% independent</div></div>
    <div class="rv d3"><div class="n" data-count="1">0</div><div class="l">Obsession: the details</div></div>
  </div>
</section>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cio = new IntersectionObserver(
    (entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        cio.unobserve(en.target);
        const el = en.target as HTMLElement;
        const target = parseInt(el.getAttribute('data-count') || '0', 10);
        if (reduced) {
          el.textContent = String(target);
          return;
        }
        let t0: number | null = null;
        function step(ts: number) {
          if (!t0) t0 = ts;
          const p = Math.min(1, (ts - t0) / 1200);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      });
    },
    { threshold: 0.5 }
  );
  document.querySelectorAll('[data-count]').forEach((el) => cio.observe(el));

  /* nightshift: ticking arcade score while on screen */
  const scoreEl = document.getElementById('ns-score');
  if (scoreEl && !reduced) {
    let score = 2048;
    let timer: ReturnType<typeof setInterval> | null = null;
    const fmt = (n: number) => n.toLocaleString('en-US').replace(/,/g, ' ');
    const sio = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (en.isIntersecting && !timer) {
          timer = setInterval(() => {
            score += 8 + Math.floor(Math.random() * 24);
            scoreEl.textContent = fmt(score);
          }, 350);
        } else if (!en.isIntersecting && timer) {
          clearInterval(timer);
          timer = null;
        }
      });
    });
    sio.observe(scoreEl);
  }
</script>
