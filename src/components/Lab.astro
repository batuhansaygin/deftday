---
// In the lab — upcoming products with living phone mockups.
---

<section id="lab" aria-labelledby="lab-title">
  <div class="sec-tag"><b>03</b> In the lab</div>
  <h2 id="lab-title" class="rv">Now brewing at <span class="serif">DeftDay.</span></h2>

  <div class="lab-row">
    <div class="rv">
      <span class="badge">In development</span>
      <span class="cat">Food delivery — iOS &amp; Android</span>
      <h3>EatStep</h3>
      <p>
        On-demand healthy food for athletes and health-conscious eaters —
        customer, partner and courier apps built end to end on one shared core.
      </p>
    </div>
    <div class="phone-wrap rv d1">
      <div class="phone">
        <div class="screen eatstep">
          <div class="sunball" aria-hidden="true"></div>
          <span class="app">EatStep</span>
          <span class="sub">Order on the way</span>
          <div class="todo" aria-hidden="true">
            <div class="t done"><i>✓</i><span></span></div>
            <div class="t done"><i>✓</i><span></span></div>
            <div class="t"><i></i><span></span></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="lab-row flip">
    <div class="rv">
      <span class="badge">In development</span>
      <span class="cat">Entertainment — Android first</span>
      <h3>Munchview</h3>
      <p>
        Open it and a good video is already playing — matched to how long your
        meal is. Under three seconds from tap to watching, no feeds, no browsing.
      </p>
    </div>
    <div class="phone-wrap rv d1">
      <div class="phone">
        <div class="screen munch">
          <span class="app">Munchview</span>
          <span class="sub">Eat. Watch. Done.</span>
          <div class="player" aria-hidden="true">
            <div class="play"></div>
            <div class="bar"><i></i></div>
            <span class="match">12 min match</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="lab-row">
    <div class="rv">
      <span class="badge">Coming soon</span>
      <span class="cat">Utility — iOS &amp; Android</span>
      <h3>Pickorn</h3>
      <p>
        An offline movie picker: choose a mood, roll the dice, watch tonight.
        Nineteen thousand IMDb-rated movies bundled in — no network, no
        scrolling paralysis.
      </p>
    </div>
    <div class="phone-wrap rv d1">
      <div class="phone">
        <div class="screen pick">
          <span class="app">Pickorn</span>
          <span class="sub">Movie night, solved</span>
          <div class="reel" aria-hidden="true">
            <div class="poster">
              <span class="line t1"></span>
              <span class="stars"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i></i></span>
              <span class="line"></span>
              <span class="line s"></span>
            </div>
            <div class="moods"><span></span><span></span><span></span></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="lab-row flip">
    <div class="rv">
      <span class="badge live">Live now</span>
      <span class="cat">Game — Web · Desktop · Mobile</span>
      <h3>SkyBattleSea</h3>
      <p>
        Fast planes vs tanky ships in a free browser battle — five modes, eight
        craft classes, real multiplayer. Kill, grow, lead.
      </p>
      <a class="lab-link" href="https://skybattlesea.com" target="_blank" rel="noopener"
        >Play at skybattlesea.com ↗</a
      >
    </div>
    <div class="phone-wrap rv d1">
      <div class="phone">
        <div class="screen sea">
          <div class="waves" aria-hidden="true"></div>
          <span class="app">SkyBattleSea</span>
          <span class="sub">Deathmatch</span>
          <div class="arcade" aria-hidden="true">
            <div class="score">×<b id="ns-score">2 048</b></div>
            <div class="track"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="numbers">
    <div class="rv"><div class="n" data-count="4">0</div><div class="l">Platforms we ship to</div></div>
    <div class="rv d1"><div class="n" data-count="4">0</div><div class="l">Products in flight</div></div>
    <div class="rv d2"><div class="n" data-count="100">0</div><div class="l">% independent</div></div>
    <div class="rv d3"><div class="n" data-count="1">0</div><div class="l">Obsession: the details</div></div>
  </div>
</section>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cio = new IntersectionObserver(
    (entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        cio.unobserve(en.target);
        const el = en.target as HTMLElement;
        const target = parseInt(el.getAttribute('data-count') || '0', 10);
        if (reduced) {
          el.textContent = String(target);
          return;
        }
        let t0: number | null = null;
        function step(ts: number) {
          if (!t0) t0 = ts;
          const p = Math.min(1, (ts - t0) / 1200);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      });
    },
    { threshold: 0.5 }
  );
  document.querySelectorAll('[data-count]').forEach((el) => cio.observe(el));

  /* skybattlesea: ticking battle score while on screen */
  const scoreEl = document.getElementById('ns-score');
  if (scoreEl && !reduced) {
    let score = 2048;
    let timer: ReturnType<typeof setInterval> | null = null;
    const fmt = (n: number) => n.toLocaleString('en-US').replace(/,/g, ' ');
    const sio = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (en.isIntersecting && !timer) {
          timer = setInterval(() => {
            score += 8 + Math.floor(Math.random() * 24);
            scoreEl.textContent = fmt(score);
          }, 350);
        } else if (!en.isIntersecting && timer) {
          clearInterval(timer);
          timer = null;
        }
      });
    });
    sio.observe(scoreEl);
  }
</script>
