---
// In the lab — upcoming products with living phone mockups.
---

<section id="lab" aria-labelledby="lab-title">
  <div class="sec-tag"><b>03</b> In the lab</div>
  <h2 id="lab-title" class="rv">Now brewing at <span class="serif">DeftDay.</span></h2>

  <div class="lab-row">
    <div class="rv">
      <span class="badge">In development</span>
      <span class="cat">Platform — iOS &amp; Android</span>
      <h3>Dawn <span class="codename">codename</span></h3>
      <p>
        The largest thing the studio has taken on: three apps for the three
        people standing at either end of one everyday transaction, running on a
        single shared core. We started it because that transaction still works
        badly for all three of them, and everyone has quietly accepted it.
      </p>
    </div>
    <div class="phone-wrap rv d1">
      <div class="phone" aria-hidden="true">
        <div class="screen wip"><span class="wip-no">Dawn</span><span class="wip-tag">Under wraps</span></div>
      </div>
    </div>
  </div>

  <div class="lab-row flip">
    <div class="rv">
      <span class="badge">In development</span>
      <span class="cat">App — Android first</span>
      <h3>Noon <span class="codename">codename</span></h3>
      <p>
        Built against a three-second stopwatch, and every argument inside it was
        settled by that number. Everything else in its category opens by asking
        what you are in the mood for. This one is built on the belief that the
        asking is the problem.
      </p>
    </div>
    <div class="phone-wrap rv d1">
      <div class="phone" aria-hidden="true">
        <div class="screen wip"><span class="wip-no">Noon</span><span class="wip-tag">Under wraps</span></div>
      </div>
    </div>
  </div>

  <div class="lab-row">
    <div class="rv">
      <span class="badge">Coming soon</span>
      <span class="cat">App — iOS &amp; Android</span>
      <h3>Dusk <span class="codename">codename</span></h3>
      <p>
        It ends the small negotiation that happens in most homes several nights
        a week, and it ends it in one tap with the phone in flight mode —
        everything it needs is already sitting on the device before you open it.
      </p>
    </div>
    <div class="phone-wrap rv d1">
      <div class="phone" aria-hidden="true">
        <div class="screen wip"><span class="wip-no">Dusk</span><span class="wip-tag">Under wraps</span></div>
      </div>
    </div>
  </div>

  <div class="lab-row flip">
    <div class="rv">
      <span class="badge live">Live now</span>
      <span class="cat">Game — Web · Desktop · Mobile</span>
      <h3>SkyBattleSea</h3>
      <p>
        Fast planes vs tanky ships in a free browser battle — five modes, eight
        craft classes, real multiplayer. Kill, grow, lead.
      </p>
      <a class="lab-link" href="https://skybattlesea.com" target="_blank" rel="noopener"
        >Play at skybattlesea.com<span aria-hidden="true"> ↗</span></a
      >
    </div>
    <div class="phone-wrap rv d1">
      <div class="phone" aria-hidden="true">
        <div class="screen sea">
          <div class="waves" aria-hidden="true"></div>
          <span class="app">SkyBattleSea</span>
          <span class="sub">Deathmatch</span>
          <div class="arcade" aria-hidden="true">
            <div class="score">×<b id="ns-score">2 048</b></div>
            <div class="track"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="numbers">
    <div class="rv"><div class="n" data-count="4">4</div><div class="l">Products in the studio</div></div>
    <div class="rv d1"><div class="n" data-count="1">1</div><div class="l">Live right now</div></div>
    <div class="rv d2"><div class="n" data-count="3">3</div><div class="l">Platforms we build for</div></div>
    <div class="rv d3"><div class="n" data-count="100">100</div><div class="l">% independent</div></div>
  </div>
</section>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cio = new IntersectionObserver(
    (entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        cio.unobserve(en.target);
        const el = en.target as HTMLElement;
        const target = parseInt(el.getAttribute('data-count') || '0', 10);
        /* The final value ships in the HTML so crawlers and no-JS visitors read
           the real number; the count-up only replays it. */
        if (reduced) return;
        let t0: number | null = null;
        function step(ts: number) {
          if (!t0) t0 = ts;
          const p = Math.min(1, (ts - t0) / 1200);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      });
    },
    { threshold: 0.5 }
  );
  document.querySelectorAll('[data-count]').forEach((el) => cio.observe(el));

  /* skybattlesea: ticking battle score while on screen */
  const scoreEl = document.getElementById('ns-score');
  if (scoreEl && !reduced) {
    let score = 2048;
    let timer: ReturnType<typeof setInterval> | null = null;
    const fmt = (n: number) => n.toLocaleString('en-US').replace(/,/g, ' ');
    const sio = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (en.isIntersecting && !timer) {
          timer = setInterval(() => {
            score += 8 + Math.floor(Math.random() * 24);
            scoreEl.textContent = fmt(score);
          }, 350);
        } else if (!en.isIntersecting && timer) {
          clearInterval(timer);
          timer = null;
        }
      });
    });
    sio.observe(scoreEl);
  }
</script>
