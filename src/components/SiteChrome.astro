---
// Page furniture that sits outside <main>: loader curtain, custom cursor,
// fixed nav — plus the site-wide interaction scripts.
---

<div id="loader" aria-hidden="true"><div class="word"></div></div>
<div id="cursor" aria-hidden="true"></div>

<a class="skip-link" href="#main">Skip to content</a>

<header class="nav" id="nav">
  <a class="logo" href="#top" aria-label="DeftDay — back to top">DEFT<em>DAY</em></a>
  <nav class="nav-links" aria-label="Main">
    <a href="#studio">Studio</a>
    <a href="#build">What we build</a>
    <a href="#lab">In the lab</a>
    <a href="#craft">Craft</a>
    <a class="btn grad" data-magnet href="#contact">Say hello</a>
  </nav>
</header>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* loader */
  const loader = document.getElementById('loader');
  const word = loader?.querySelector('.word');
  if (loader && word) {
    'DEFTDAY'.split('').forEach((ch, i) => {
      const s = document.createElement('span');
      s.textContent = ch;
      s.style.animationDelay = i * 0.03 + 's';
      if (i >= 4) {
        s.style.background = 'linear-gradient(120deg,#ff5c38,#ffb03a)';
        s.style.webkitBackgroundClip = 'text';
        s.style.backgroundClip = 'text';
        s.style.color = 'transparent';
      }
      word.appendChild(s);
    });
    let finished = false;
    const finish = () => {
      if (finished) return;
      finished = true;
      loader.classList.add('done');
      setTimeout(() => loader.remove(), 600);
    };
    setTimeout(finish, reduced ? 0 : 620); /* curtain gone by ~1.1s */
    loader.addEventListener('click', finish); /* skippable */
    window.addEventListener('keydown', finish, { once: true });
  }

  /* cursor */
  const cursor = document.getElementById('cursor');
  if (cursor) {
    let cx = 0,
      cy = 0,
      cursorTick = false;
    document.addEventListener(
      'mousemove',
      (e) => {
        cx = e.clientX;
        cy = e.clientY;
        if (cursorTick) return;
        cursorTick = true;
        requestAnimationFrame(() => {
          cursorTick = false;
          cursor.style.setProperty('--cx', cx + 'px');
          cursor.style.setProperty('--cy', cy + 'px');
        });
      },
      { passive: true }
    );
    document.querySelectorAll('a,button,.card,.craft-item').forEach((el) => {
      el.addEventListener('mouseenter', () => cursor.classList.add('big'));
      el.addEventListener('mouseleave', () => cursor.classList.remove('big'));
    });
  }

  /* nav scroll state */
  const nav = document.getElementById('nav');
  let navTick = false;
  window.addEventListener(
    'scroll',
    () => {
      if (navTick) return;
      navTick = true;
      requestAnimationFrame(() => {
        navTick = false;
        nav?.classList.toggle('scrolled', window.scrollY > 40);
      });
    },
    { passive: true }
  );

  /* magnetic buttons */
  if (!reduced && matchMedia('(hover:hover)').matches) {
    document.querySelectorAll<HTMLElement>('[data-magnet]').forEach((btn) => {
      btn.addEventListener('mousemove', (e) => {
        const r = btn.getBoundingClientRect();
        const x = e.clientX - r.left - r.width / 2;
        const y = e.clientY - r.top - r.height / 2;
        btn.style.transform = `translate(${x * 0.18}px,${y * 0.24}px) scale(1.05)`;
      });
      btn.addEventListener('mouseleave', () => (btn.style.transform = ''));
    });
  }

  /* blob parallax — translate (compositor-only) instead of margin (layout),
     batched into one animation frame so scrolling never thrashes layout */
  if (!reduced) {
    const blobs = Array.from(document.querySelectorAll<HTMLElement>('.blob'));
    let blobTick = false;
    const moveBlobs = () => {
      blobTick = false;
      const y = window.scrollY;
      blobs.forEach((b, i) => {
        b.style.setProperty('--py', y * (0.06 + i * 0.04) + 'px');
      });
    };
    window.addEventListener(
      'scroll',
      () => {
        if (blobTick) return;
        blobTick = true;
        requestAnimationFrame(moveBlobs);
      },
      { passive: true }
    );
  }

  /* reveal on view (global) */
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((en) => {
        if (en.isIntersecting) {
          en.target.classList.add('on');
          io.unobserve(en.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  document.querySelectorAll('.rv').forEach((el) => io.observe(el));
</script>
