---
/**
 * Signing in with an address and a password, beside the Google button.
 *
 * Two doors, one account. The service links a Google sign-in onto an existing
 * password account when Google says it verified the address, so somebody who
 * registers here and later taps the Google button lands on the same record
 * rather than a second empty one.
 *
 * The session that comes back is the same 30-day one Google's exchange
 * returns, kept in the same place, so everything downstream — /watch, the
 * header swap on the home page — works without knowing which door was used.
 */
import { CONTENT_API_URL, APP_PATH } from '../config/munchview';

interface Props {
  next?: string;
}
const { next = APP_PATH } = Astro.props as Props;
---

<div class="pw" data-api={CONTENT_API_URL} data-next={next}>
  <div class="or"><span>or</span></div>

  <form class="form" novalidate>
    <label class="field">
      <span>Email</span>
      <input name="email" type="email" autocomplete="email" required inputmode="email" />
    </label>
    <label class="field">
      <span>Password</span>
      <!-- current-password, not new-password: this form starts as sign-in, and
           telling a password manager otherwise makes it offer to generate one
           over the field somebody is trying to fill. -->
      <input name="password" type="password" autocomplete="current-password" required />
    </label>

    <p class="note" data-hint hidden></p>
    <p class="error" role="alert" hidden></p>

    <button class="btn" type="submit" data-submit>Sign in</button>
    <button class="link" type="button" data-toggle>Create an account instead</button>
  </form>
</div>

<script is:inline>
  (function () {
    var root = document.querySelector('.pw');
    if (!root) return;
    var api = root.getAttribute('data-api');
    var next = root.getAttribute('data-next') || '/watch';
    var form = root.querySelector('.form');
    var email = form.elements.namedItem('email');
    var password = form.elements.namedItem('password');
    var submit = root.querySelector('[data-submit]');
    var toggle = root.querySelector('[data-toggle]');
    var errorEl = root.querySelector('.error');
    var hintEl = root.querySelector('[data-hint]');
    var registering = false;

    /* The service refuses anything shorter. Saying so before the round trip is
       the difference between a form that helps and one that scolds. */
    var MIN = 12;

    function fail(message) {
      errorEl.textContent = message;
      errorEl.hidden = false;
    }

    function setMode(next) {
      registering = next;
      submit.textContent = registering ? 'Create account' : 'Sign in';
      toggle.textContent = registering
        ? 'I already have an account'
        : 'Create an account instead';
      password.setAttribute('autocomplete', registering ? 'new-password' : 'current-password');
      hintEl.textContent = registering ? 'At least ' + MIN + ' characters.' : '';
      hintEl.hidden = !registering;
      errorEl.hidden = true;
    }

    toggle.addEventListener('click', function () {
      setMode(!registering);
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      errorEl.hidden = true;
      var address = email.value.trim();
      var secret = password.value;
      if (!address || !secret) return fail('Fill in both fields.');
      if (registering && secret.length < MIN) {
        return fail('Passwords need at least ' + MIN + ' characters.');
      }

      submit.disabled = true;
      submit.textContent = registering ? 'Creating…' : 'Signing in…';

      fetch(api + (registering ? '/auth/register' : '/auth/login'), {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email: address, password: secret }),
      })
        .then(function (r) {
          return r.json().then(function (body) {
            return { status: r.status, body: body };
          });
        })
        .then(function (res) {
          if (res.status === 409) {
            /* Deliberately not linked, and the person is told what to do
               rather than left to guess. See the Worker's /auth/register. */
            throw new Error(
              'That address already has an account. Sign in with your password, or with Google if that is how you made it.',
            );
          }
          if (res.status === 401) throw new Error('Wrong email or password.');
          if (res.status === 400) throw new Error('Passwords need at least ' + MIN + ' characters.');
          if (res.status === 429) throw new Error('Too many attempts. Wait a moment and try again.');
          if (!res.body || !res.body.session) throw new Error('Munchview could not finish that. Try again in a moment.');
          try {
            localStorage.setItem('mv_session', res.body.session);
          } catch (err) {
            throw new Error('This browser is blocking storage, so the sign-in cannot be kept.');
          }
          window.location.assign(next);
        })
        .catch(function (err) {
          submit.disabled = false;
          submit.textContent = registering ? 'Create account' : 'Sign in';
          fail(err && err.message ? err.message : 'Something went wrong. Try again.');
        });
    });

    setMode(false);
  })();
</script>

<style>
  .pw { width: 100%; display: flex; flex-direction: column; gap: 18px; }
  .or {
    display: flex; align-items: center; gap: 12px; color: #8d949b; font-size: 13px;
  }
  .or::before, .or::after { content: ''; flex: 1; height: 1px; background: #222633; }
  .form { display: flex; flex-direction: column; gap: 12px; text-align: left; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field span { color: #8d949b; font-size: 13px; }
  .field input {
    background: #0e101a; border: 1px solid #222633; color: #eef2f6;
    border-radius: 10px; height: 46px; padding: 0 14px; font: inherit; font-size: 15px;
  }
  .field input:focus { border-color: #ffb300; outline: none; }
  .btn {
    background: #ffb300; color: #1a1200; font-weight: 800; border: 0;
    border-radius: 100px; min-height: 46px; font: inherit; font-weight: 800;
    font-size: 15px; cursor: pointer; margin-top: 4px;
  }
  .btn:disabled { opacity: .6; cursor: default; }
  .link {
    background: none; border: 0; color: #8d949b; font: inherit; font-size: 13.5px;
    text-decoration: underline; cursor: pointer; padding: 10px; min-height: 44px;
  }
  .link:hover { color: #eef2f6; }
  .note { margin: 0; color: #8d949b; font-size: 13px; }
  .error { margin: 0; color: #ffb300; font-size: 13.5px; }
</style>
