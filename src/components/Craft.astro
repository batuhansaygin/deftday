---
// Craft — everything in-house.
---

<section id="craft" aria-labelledby="craft-title">
  <div class="sec-tag"><b>04</b> Craft</div>
  <h2 id="craft-title" class="rv" style="margin-bottom:56px">
    Everything <span class="nb">in-house,</span><br /><span class="serif">nothing off the shelf.</span>
  </h2>
  <div class="craft-list">
    <div class="craft-item rv">
      <span class="idx">001</span><span class="name">Product Design</span>
      <span class="desc">Interfaces that explain themselves — every screen earns its place.</span>
    </div>
    <div class="craft-item rv">
      <span class="idx">002</span><span class="name">Engineering</span>
      <span class="desc">Native-feel performance on iOS and Android, built to last.</span>
    </div>
    <div class="craft-item rv">
      <span class="idx">003</span><span class="name">Motion &amp; Sound</span>
      <span class="desc">The 5% of polish that makes an app feel twice the price.</span>
    </div>
    <div class="craft-item rv">
      <span class="idx">004</span><span class="name">Store Presence</span>
      <span class="desc">Icons, screenshots and copy tuned for the moment of download.</span>
    </div>
  </div>
</section>
