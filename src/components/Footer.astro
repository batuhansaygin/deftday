---
const year = new Date().getFullYear();

// Same reasoning as the nav in SiteChrome: these sections live on the home
// page, so off it the bare hash resolves to nothing and the link is dead.
const path = Astro.url.pathname.replace(/\/index\.html$/, '/');
const isHome = path === '/';
const to = (id: string) => (isHome ? `#${id}` : `/#${id}`);
---

<footer>
  <a
    class="foot-word"
    href={isHome ? '#top' : '/'}
    aria-label={isHome ? 'DeftDay — back to top' : 'DeftDay — back to the studio'}
    >DEFTDAY</a
  >

  <!-- Also the only in-page navigation below 820px, where the fixed nav
       collapses to just the contact button. -->
  <!-- About and Contact are real pages, not sections, so they are linked
       directly rather than through to(): a hash would send somebody looking
       for the studio's address to a scroll position on the home page. -->
  <nav class="foot-nav" aria-label="Sections">
    <a href={to('studio')}>Studio</a>
    <a href={to('build')}>What we build</a>
    <a href={to('lab')}>In the lab</a>
    <a href={to('craft')}>Craft</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
    <a href="/munchview">Munchview</a>
  </nav>

  <!-- The legal pages get their own row rather than being lost among the
       sections: /terms was previously reachable only by typing the URL, which
       is not "reachable" for a document a store links to. -->
  <nav class="foot-legal" aria-label="Legal">
    <a href="/privacy">Privacy</a>
    <a href="/terms">Terms of Use</a>
    <a href="/refunds">Refunds &amp; withdrawal</a>
    <a href="/kvkk" hreflang="tr">Turkish data-protection notice</a>
  </nav>

  <div class="foot-meta">
    <!-- Build-time year, corrected client-side so a static build doesn't go
         stale on January 1st. -->
    <span>© <span id="year">{year}</span> DeftDay Studio. All rights reserved.</span>
    <span><a href="mailto:hello@deftday.com">hello@deftday.com</a></span>
    <span>Crafted deftly, daily.</span>
  </div>
</footer>

<script is:inline>
  {
    const el = document.getElementById('year');
    const now = String(new Date().getFullYear());
    if (el && el.textContent !== now) el.textContent = now;
  }
</script>
